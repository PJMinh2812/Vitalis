<script src="js/pages/AdminServices.js"></script>

@code {
    private List<ServiceDto> AllServices { get; set; } = [];
    private List<SpecialtyDto> Specialties { get; set; } = [];
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private string Keyword { get; set; } = "";
    private string SpecialtyFilter { get; set; } = "";
    private string StatusFilter { get; set; } = "";

    private bool ShowCreateForm { get; set; }
    private bool IsSaving { get; set; }
    private string NewCode { get; set; } = "";
    private string NewSpecialtyId { get; set; } = "";
    private string NewName { get; set; } = "";
    private string NewDescription { get; set; } = "";
    private decimal NewPrice { get; set; }
    private int? NewDurationMinutes { get; set; }

    private List<ServiceDto> FilteredServices => AllServices.Where(s =>
        (string.IsNullOrWhiteSpace(Keyword)
            || s.Name.Contains(Keyword, StringComparison.OrdinalIgnoreCase)
            || (s.Code?.Contains(Keyword, StringComparison.OrdinalIgnoreCase) ?? false))
        && (string.IsNullOrEmpty(SpecialtyFilter) || s.SpecialtyId == int.Parse(SpecialtyFilter))
        && (StatusFilter switch { "active" => s.IsActive, "inactive" => !s.IsActive, _ => true }))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            AllServices = (await Api.GetAsync<IReadOnlyList<ServiceDto>>("api/services")).ToList();
            Specialties = (await Api.GetAsync<IReadOnlyList<SpecialtyDto>>("api/specialties")).ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string SpecialtyName(int? specialtyId) =>
        specialtyId is null ? "-" : Specialties.FirstOrDefault(s => s.Id == specialtyId)?.Name ?? "-";

    private void ClearFilters()
    {
        Keyword = "";
        SpecialtyFilter = "";
        StatusFilter = "";
    }

    private void OpenCreateForm()
    {
        NewCode = "";
        NewSpecialtyId = "";
        NewName = "";
        NewDescription = "";
        NewPrice = 0;
        NewDurationMinutes = null;
        ErrorMessage = null;
        ShowCreateForm = true;
    }

    private async Task CreateServiceAsync()
    {
        IsSaving = true;
        try
        {
            var request = new CreateServiceRequest(
                string.IsNullOrWhiteSpace(NewCode) ? null : NewCode,
                string.IsNullOrEmpty(NewSpecialtyId) ? null : int.Parse(NewSpecialtyId),
                NewName,
                string.IsNullOrWhiteSpace(NewDescription) ? null : NewDescription,
                NewPrice,
                NewDurationMinutes);
            var created = await Api.PostAsync<CreateServiceRequest, ServiceDto>("api/admin/services", request);
            AllServices.Add(created);
            ShowCreateForm = false;
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeactivateAsync(int id)
    {
        try
        {
            await Api.PatchNoContentAsync<object?>($"api/admin/services/{id}/deactivate", null);
            var index = AllServices.FindIndex(s => s.Id == id);
            if (index >= 0)
            {
                var s = AllServices[index];
                AllServices[index] = s with { IsActive = false };
            }
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
    }
}
