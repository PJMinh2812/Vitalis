@page "/admin/services"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject VitalisApiClient Api
@using Vitalis.Application.DTOs.Billing
@using Vitalis.Application.DTOs.Doctors

<PageTitle>Danh mục dịch vụ · Vitalis</PageTitle>

<div class="flex flex-col w-full gap-space-lg pb-12">
<!-- Top Context Header & Actions -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-container-lowest p-6 rounded-xl shadow-sm">
<div class="flex flex-col gap-2">
<div class="flex flex-wrap items-center gap-2">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high text-primary font-label-xs text-label-xs">
<span class="material-symbols-outlined text-[15px]">verified</span>
          VC-30 • Chuẩn Thông tư 13/2023/TT-BYT &amp; Quyết định 7618/QĐ-BYT
        </span>
<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-xs text-label-xs">
<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          Đồng bộ Cổng Giám định BHYT &amp; HIS
        </span>
</div>
<div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
          Quản Lý Danh Mục Dịch Vụ Kỹ Thuật &amp; Biểu Giá Viện Phí
        </h1>
<p class="font-body-md text-body-md text-on-surface-variant max-w-4xl mt-1">
          Thiết lập định mức chi phí, giá viện phí thu trực tiếp, giá trần BHYT thanh toán, tỷ lệ đồng chi trả, cấu hình gói khám doanh nghiệp và kiểm soát phiên bản bảng giá toàn viện.
        </p>
</div>
</div>
<!-- Global Operations Group -->
<div class="flex flex-wrap items-center gap-2 self-start lg:self-center shrink-0">
<button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors shadow-sm" type="button">
<span class="material-symbols-outlined text-[18px]">download</span>
        Xuất Bảng Giá
      </button>
<button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors shadow-sm" type="button">
<span class="material-symbols-outlined text-[18px]">upload_file</span>
        Nhập Dữ Liệu Excel
      </button>
<button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-surface-container-high text-primary font-label-md text-label-md hover:bg-surface-container transition-colors" type="button">
<span class="material-symbols-outlined text-[18px]">history</span>
        Phiên bản 4.2
      </button>
<button class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md shadow-sm hover:opacity-95 transition-opacity" type="button" @onclick="OpenCreateForm">
<span class="material-symbols-outlined text-[18px]">add_circle</span>
        + Thêm Kỹ Thuật Mới
      </button>
</div>
</div>
@if (ErrorMessage is not null)
{
<div class="flex items-start gap-3 p-3.5 rounded-lg bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-[20px] shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@ErrorMessage</p>
</div>
}
@if (ShowCreateForm)
{
<div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm flex flex-col gap-4">
<h2 class="font-title-md text-title-md text-on-surface font-bold">Thêm Kỹ Thuật / Dịch Vụ Mới</h2>
<form class="grid grid-cols-1 md:grid-cols-2 gap-4" @onsubmit="CreateServiceAsync" @onsubmit:preventDefault="true">
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Mã dịch vụ</label>
<input class="h-10 px-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" @bind="NewCode"/>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Chuyên khoa</label>
<select class="h-10 px-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none" @bind="NewSpecialtyId">
<option value="">-- Không thuộc chuyên khoa --</option>
@foreach (var specialty in Specialties)
{
<option value="@specialty.Id">@specialty.Name</option>
}
</select>
</div>
<div class="flex flex-col gap-1.5 md:col-span-2">
<label class="font-label-md text-label-md text-on-surface">Tên dịch vụ <span class="text-error">*</span></label>
<input class="h-10 px-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required @bind="NewName"/>
</div>
<div class="flex flex-col gap-1.5 md:col-span-2">
<label class="font-label-md text-label-md text-on-surface">Mô tả</label>
<input class="h-10 px-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" @bind="NewDescription"/>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Giá (VND) <span class="text-error">*</span></label>
<input class="h-10 px-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required type="number" @bind="NewPrice"/>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Thời gian (phút)</label>
<input class="h-10 px-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" type="number" @bind="NewDurationMinutes"/>
</div>
<div class="md:col-span-2 flex items-center justify-end gap-3">
<button class="px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-title-md text-title-md transition-colors" type="button" @onclick="() => ShowCreateForm = false">Huỷ</button>
<button class="px-5 py-2.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md font-semibold transition-colors shadow-sm disabled:opacity-60" disabled="@IsSaving" type="submit">@(IsSaving ? "Đang lưu..." : "Lưu dịch vụ")</button>
</div>
</form>
</div>
}
<!-- KPI Metrics Banner (Bento 4-card grid) -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
<!-- Card 1 -->
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden">
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng Số Kỹ Thuật Đang Dùng</span>
<div class="w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[20px]">medical_services</span>
</div>
</div>
<div class="mt-3">
<div class="flex items-baseline gap-2">
<span class="font-display text-display text-on-surface">@AllServices.Count</span>
<span class="font-label-sm text-label-sm text-primary font-semibold">@(AllServices.Count(s => s.IsActive)) đang áp dụng</span>
</div>
</div>
</div>
<!-- Card 2 -->
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden">
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Danh Mục BHYT Chi Trả</span>
<div class="w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[20px]">health_and_safety</span>
</div>
</div>
<div class="mt-3">
<div class="flex items-baseline gap-2">
<span class="font-display text-display text-on-surface">418</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-semibold">77.1% danh mục</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          100% khớp mã Giám định BHXH, 0 dịch vụ treo phê duyệt
        </p>
</div>
<div class="w-full bg-surface-container-low h-1.5 rounded-full mt-4 overflow-hidden">
<div class="bg-primary-container h-full rounded-full" style="width: 77.1%"></div>
</div>
</div>
<!-- Card 3 -->
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden">
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Biên Lợi Nhuận Gộp Định Mức</span>
<div class="w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-secondary">
<span class="material-symbols-outlined text-[20px]">trending_up</span>
</div>
</div>
<div class="mt-3">
<div class="flex items-baseline gap-2">
<span class="font-display text-display text-on-surface">68.4%</span>
<span class="font-label-sm text-label-sm text-primary font-semibold">+2.1% tối ưu</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          Định mức vật tư tiêu hao &amp; khấu hao máy đo theo thời gian thực
        </p>
</div>
<div class="w-full bg-surface-container-low h-1.5 rounded-full mt-4 overflow-hidden">
<div class="bg-secondary h-full rounded-full" style="width: 68.4%"></div>
</div>
</div>
<!-- Card 4 -->
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden">
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Phiên Bản Giá &amp; Hiệu Lực</span>
<div class="w-9 h-9 rounded-lg bg-surface-container-low flex items-center justify-center text-tertiary">
<span class="material-symbols-outlined text-[20px]">verified_user</span>
</div>
</div>
<div class="mt-3">
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg text-on-surface">v2026.4</span>
<span class="inline-flex px-2 py-0.5 rounded-full bg-surface-container-high text-primary font-label-xs text-label-xs font-semibold">Đang hiệu lực</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          Áp dụng từ 01/10/2026 • <strong>06 kỹ thuật</strong> chờ ký số duyệt
        </p>
</div>
<div class="w-full bg-surface-container-low h-1.5 rounded-full mt-4 overflow-hidden">
<div class="bg-primary h-full rounded-full" style="width: 90%"></div>
</div>
</div>
</div>
<!-- Operational Filter Toolbar -->
<div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col gap-3">
<div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3">
<!-- Search Input -->
<div class="relative flex-1 min-w-[320px]">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
<input class="w-full h-10 pl-9 pr-10 py-2 bg-surface-container-low text-on-surface text-body-md font-body-md rounded-lg focus:outline-none focus:bg-surface-container transition-all" id="serviceSearch" placeholder="Tìm theo tên dịch vụ, mã nội bộ..." type="text" @bind="Keyword" @bind:event="oninput"/>
</div>
<!-- Category Filter Dropdowns -->
<div class="flex flex-wrap items-center gap-2">
<select class="h-10 px-3 bg-surface-container-low text-on-surface text-body-sm font-body-sm rounded-lg focus:outline-none cursor-pointer" @bind="SpecialtyFilter">
<option value="">Tất cả chuyên khoa</option>
@foreach (var specialty in Specialties)
{
<option value="@specialty.Id">@specialty.Name</option>
}
</select>
<select class="h-10 px-3 bg-surface-container-low text-on-surface text-body-sm font-body-sm rounded-lg focus:outline-none cursor-pointer" @bind="StatusFilter">
<option value="">Tất cả trạng thái</option>
<option value="active">Đang áp dụng</option>
<option value="inactive">Ngưng áp dụng</option>
</select>
</div>
</div>
<!-- Quick Badges Sub-bar -->
<div class="flex flex-wrap items-center gap-2 pt-2">
<span class="font-label-xs text-label-xs text-on-surface-variant font-semibold uppercase tracking-wider mr-1">Lối tắt:</span>
<button class="px-3 py-1 rounded-full bg-primary-container text-on-primary font-label-xs text-label-xs transition-opacity hover:opacity-90" type="button" @onclick="ClearFilters">
        Tất cả dịch vụ (@AllServices.Count)
      </button>
</div>
</div>
<!-- Master Data Table Section -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
<!-- Table Header Info Bar -->
<div class="px-6 py-4 bg-surface-container-lowest flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
<div class="flex items-center gap-3">
<span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
<h2 class="font-title-md text-title-md text-on-surface">Biểu Giá &amp; Định Mức Chi Phí Toàn Viện</h2>
<span class="px-2 py-0.5 rounded-md bg-surface-container-high text-primary font-label-xs text-label-xs font-semibold">Live HIS/LIS sync</span>
</div>
<div class="flex items-center gap-3 font-body-sm text-body-sm text-on-surface-variant">
<span>Đơn vị tính: <strong>VNĐ</strong></span>
<span>•</span>
<span>Cập nhật gần nhất: <strong>10:45 Hôm nay</strong></span>
</div>
</div>
<!-- Responsive Master Table -->
<div class="overflow-x-auto w-full">
<table class="w-full text-left">
<thead>
<tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm">
<th class="py-3 px-4 font-semibold">Mã DV &amp; Tên Kỹ Thuật</th>
<th class="py-3 px-4 font-semibold">Chuyên Khoa</th>
<th class="py-3 px-4 font-semibold text-right">Thời Lượng</th>
<th class="py-3 px-4 font-semibold text-right">Giá (đ)</th>
<th class="py-3 px-4 font-semibold text-center">Trạng Thái</th>
<th class="py-3 px-4 font-semibold text-right">Thao Tác</th>
</tr>
</thead>
<tbody class="font-body-md text-body-md text-on-surface">
@if (IsLoading)
{
<tr><td class="py-3.5 px-4 text-on-surface-variant" colspan="6">Đang tải...</td></tr>
}
else if (FilteredServices.Count == 0)
{
<tr><td class="py-3.5 px-4 text-on-surface-variant" colspan="6">Không có dịch vụ nào khớp bộ lọc.</td></tr>
}
else
{
@foreach (var service in FilteredServices)
{
<tr class="hover:bg-surface-container-low/60 transition-colors">
<td class="py-3.5 px-4">
<div class="flex flex-col min-w-0">
<span class="font-label-sm text-label-sm text-primary font-mono font-semibold">@service.Code</span>
<span class="font-title-md text-body-md text-on-surface truncate font-medium">@service.Name</span>
</div>
</td>
<td class="py-3.5 px-4 text-body-sm text-on-surface-variant">@SpecialtyName(service.SpecialtyId)</td>
<td class="py-3.5 px-4 text-right font-mono text-body-sm text-on-surface-variant">@(service.DurationMinutes is { } m ? $"{m} phút" : "-")</td>
<td class="py-3.5 px-4 text-right font-mono font-semibold text-body-md text-primary">@service.Price.ToString("N0")</td>
<td class="py-3.5 px-4 text-center">
@if (service.IsActive)
{
<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container text-primary font-label-xs text-label-xs font-semibold">
<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                Áp dụng
              </span>
}
else
{
<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-xs text-label-xs font-semibold">
                Ngừng
              </span>
}
</td>
<td class="py-3.5 px-4 text-right">
@if (service.IsActive)
{
<button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-error transition-colors" title="Ngừng áp dụng" type="button" @onclick="() => DeactivateAsync(service.Id)">
<span class="material-symbols-outlined text-[18px]">block</span>
</button>
}
</td>
</tr>
}
}
</tbody>
</table>
</div>
<!-- Table Footer -->
<div class="p-4 bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-3">
<div class="font-body-sm text-body-sm text-on-surface-variant">
        Hiển thị <span class="font-semibold text-on-surface">@FilteredServices.Count</span> trên tổng số <span class="font-semibold text-on-surface">@AllServices.Count</span> dịch vụ kỹ thuật
      </div>
</div>
</div>
<!-- Deep Analytical & Executive Panels (3-Card Layout) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
<!-- Panel 1: Cost-Breakdown Model -->
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex flex-col justify-between">
<div>
<div class="flex items-center justify-between pb-3">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">pie_chart</span>
<h3 class="font-title-md text-title-md text-on-surface">Cơ Cấu Cấu Thành Giá Dịch Vụ</h3>
</div>
<span class="font-label-xs text-label-xs px-2 py-0.5 rounded-full bg-surface-container-high text-primary font-semibold">DV-HA-022</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          Mô hình chi phí định mức ca: <strong class="text-on-surface">Siêu âm Tim Doppler màu (550.000 đ)</strong>
</p>
<!-- Visual Segmented Bar -->
<div class="w-full h-3 rounded-full flex overflow-hidden mt-4 bg-surface-container-low">
<div class="bg-primary h-full" style="width: 32%" title="Nhân công y bác sĩ: 32%"></div>
<div class="bg-primary-container h-full" style="width: 24%" title="Khấu hao máy siêu âm: 24%"></div>
<div class="bg-secondary h-full" style="width: 22%" title="Tích lũy tái đầu tư: 22%"></div>
<div class="bg-tertiary h-full" style="width: 14%" title="Vật tư tiêu hao: 14%"></div>
<div class="bg-outline-variant h-full" style="width: 8%" title="Vận hành chung: 8%"></div>
</div>
<!-- Metric Details List -->
<div class="flex flex-col gap-2.5 mt-4 font-body-sm text-body-sm">
<div class="flex items-center justify-between">
<span class="flex items-center gap-2 text-on-surface-variant">
<span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
              Nhân công Y Bác sĩ CKII &amp; KTV
            </span>
<span class="font-mono font-medium text-on-surface">32% (176.000 đ)</span>
</div>
<div class="flex items-center justify-between">
<span class="flex items-center gap-2 text-on-surface-variant">
<span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
              Khấu hao Máy Philips EPIQ Elite &amp; PACS
            </span>
<span class="font-mono font-medium text-on-surface">24% (132.000 đ)</span>
</div>
<div class="flex items-center justify-between">
<span class="flex items-center gap-2 text-on-surface-variant">
<span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
              Lợi nhuận tích lũy tái đầu tư y tế
            </span>
<span class="font-mono font-medium text-on-surface">22% (121.000 đ)</span>
</div>
<div class="flex items-center justify-between">
<span class="flex items-center gap-2 text-on-surface-variant">
<span class="w-2.5 h-2.5 rounded-full bg-tertiary"></span>
              Vật tư tiêu hao (Gel, giấy in, găng vô khuẩn)
            </span>
<span class="font-mono font-medium text-on-surface">14% (77.000 đ)</span>
</div>
<div class="flex items-center justify-between">
<span class="flex items-center gap-2 text-on-surface-variant">
<span class="w-2.5 h-2.5 rounded-full bg-outline-variant"></span>
              Chi phí gián tiếp &amp; vận hành phòng khám
            </span>
<span class="font-mono font-medium text-on-surface">8% (44.000 đ)</span>
</div>
</div>
</div>
<div class="pt-4 mt-2 flex items-center justify-between">
<span class="font-label-xs text-label-xs text-primary font-semibold">Tối ưu định mức tự động chuẩn ISO</span>
<button class="font-label-sm text-label-sm text-primary hover:underline font-semibold" type="button">
          Xem định mức toàn khoa →
        </button>
</div>
</div>
<!-- Panel 2: Corporate Packages Management -->
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex flex-col justify-between">
<div>
<div class="flex items-center justify-between pb-3">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">corporate_fare</span>
<h3 class="font-title-md text-title-md text-on-surface">Gói Khám Doanh Nghiệp (B2B)</h3>
</div>
<span class="font-label-xs text-label-xs px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-semibold">Q3/2026</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          Chính sách chiết khấu bậc thang theo số lượng nhân sự đoàn khám
        </p>
<!-- Packages List -->
<div class="flex flex-col gap-3 mt-4">
<!-- Item 1 -->
<div class="p-3 rounded-lg bg-surface-container-low flex items-center justify-between">
