@page "/reception/queue"
@layout ReceptionLayout
@attribute [Authorize(Roles = "Receptionist")]
@inject VitalisApiClient Api
@using Vitalis.Application.Common
@using Vitalis.Application.DTOs.Appointments
@using Vitalis.Application.DTOs.Doctors
@using Vitalis.Domain.Enums

<PageTitle>Hàng chờ &amp; cấp số · Vitalis</PageTitle>

<div class="flex flex-col w-full">
<!-- Main Content Wrapper -->
<div class="px-space-xl py-space-lg flex flex-col gap-space-xl max-w-[1600px] mx-auto w-full">
<!-- Top Action Bar & Page Header -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
<div class="flex flex-col gap-1">
<div class="flex items-center gap-2">
<span class="font-label-xs text-label-xs font-bold uppercase tracking-wider text-primary px-2 py-0.5 rounded bg-primary/10">Điều phối luồng khám</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Hàng chờ phòng khám &amp; Điều phối cấp số</h1>
<p class="font-body-md text-body-md text-on-surface-variant">Theo dõi thời gian thực tiến độ khám tại các phòng ban và điều phối luồng bệnh nhân</p>
</div>
<div class="flex flex-wrap items-center gap-3">
<button class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container-lowest shadow-sm hover:bg-surface-container-low transition-colors" @onclick="LoadAsync">
<span class="material-symbols-outlined text-[18px] text-primary">sync</span>
<span class="font-label-sm text-label-sm text-on-surface">Làm mới ngay</span>
</button>
</div>
</div>
@if (ErrorMessage is not null)
{
<div class="p-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@ErrorMessage</div>
}
<!-- KHỐI 1: CÁC THẺ PHÒNG KHÁM ĐANG HOẠT ĐỘNG -->
<div class="flex flex-col gap-space-md">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">meeting_room</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Phòng khám đang hoạt động</h2>
<span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-xs text-label-xs font-bold">@RoomQueues.Count phòng có bệnh nhân</span>
</div>
</div>
@if (RoomQueues.Count == 0)
{
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm text-center text-on-surface-variant font-body-sm text-body-sm">Chưa có bệnh nhân nào trong hàng chờ hôm nay.</div>
}
else
{
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg">
@foreach (var room in RoomQueues)
{
<div class="flex flex-col bg-surface-container-lowest rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden group">
<div class="p-space-md bg-surface-container-low flex items-start justify-between">
<div class="flex flex-col gap-0.5">
<div class="flex items-center gap-2">
<span class="px-2 py-0.5 rounded bg-primary-container text-on-primary font-label-xs text-label-xs font-bold uppercase tracking-wider">@(room.Room ?? "Chưa xếp phòng")</span>
</div>
<div class="flex items-center gap-1.5 text-on-surface-variant font-body-sm text-body-sm">
<span class="material-symbols-outlined text-[16px] text-tertiary">stethoscope</span>
<span>@room.DoctorName</span>
</div>
</div>
</div>
<div class="p-space-md flex flex-col gap-space-md flex-1 justify-between">
<div class="grid grid-cols-2 gap-3">
<div class="p-3.5 rounded-xl bg-primary-container text-on-primary flex flex-col justify-between shadow-sm relative overflow-hidden">
<div class="flex items-center justify-between mb-1 relative z-10">
<span class="font-label-xs text-label-xs font-bold uppercase tracking-wider text-on-primary/90 flex items-center gap-1">Đang khám</span>
</div>
@if (room.Current is not null)
{
<div class="my-1 relative z-10">
<span class="font-display text-display font-black tracking-tight leading-none">#@room.Current.QueueNumber?.ToString("00")</span>
</div>
<div class="flex flex-col relative z-10">
<span class="font-title-md text-title-md font-bold truncate">@room.Current.PatientName</span>
</div>
}
else
{
<div class="flex flex-col relative z-10 py-2">
<span class="font-body-sm text-body-sm text-on-primary/80">Chưa có bệnh nhân</span>
</div>
}
</div>
<div class="p-3.5 rounded-xl bg-surface-container-low flex flex-col justify-between relative overflow-hidden">
<div class="flex items-center justify-between mb-1">
<span class="font-label-xs text-label-xs font-bold uppercase tracking-wider text-on-surface-variant flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">arrow_forward</span> Tiếp theo
                  </span>
</div>
@if (room.Next is not null)
{
<div class="my-1">
<span class="font-display text-display font-black tracking-tight text-on-surface leading-none">#@room.Next.QueueNumber?.ToString("00")</span>
</div>
<div class="flex flex-col">
<span class="font-title-md text-title-md font-bold text-on-surface truncate">@room.Next.PatientName</span>
</div>
}
else
{
<div class="flex flex-col py-2">
<span class="font-body-sm text-body-sm text-on-surface-variant">Không có</span>
</div>
}
</div>
</div>
<div class="flex items-center justify-between pt-2">
<div class="flex items-center gap-1.5 text-on-surface-variant font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[16px] text-tertiary">groups</span>
<span>Đang chờ: <strong class="text-on-surface font-semibold">@room.WaitingCount người</strong></span>
</div>
</div>
</div>
</div>
}
</div>
}
</div>
<!-- KHỐI 2: BẢNG ĐIỀU PHỐI DANH SÁCH CHỜ KHÁM -->
<div class="flex flex-col bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
<div class="p-space-md bg-surface-container-lowest flex flex-col md:flex-row md:items-center justify-between gap-space-md">
<div class="flex items-center gap-3">
<div class="relative w-80">
<span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-[18px]">search</span>
<input class="w-full h-10 pl-9 pr-3 rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary shadow-inner" placeholder="Lọc theo tên, số phiếu #, bác sĩ..." type="text" @bind="SearchKeyword" @bind:event="oninput"/>
</div>
</div>
</div>
<div class="w-full overflow-x-auto">
<table class="w-full text-left">
<thead class="bg-surface-container-low sticky top-0 z-10 text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider select-none">
<tr>
<th class="py-3 px-4 w-16 text-center">STT</th>
<th class="py-3 px-4 min-w-[190px]">Bệnh nhân</th>
<th class="py-3 px-4 min-w-[200px]">Phòng khám &amp; Bác sĩ</th>
<th class="py-3 px-4 min-w-[90px]">Giờ hẹn</th>
<th class="py-3 px-4 min-w-[110px]">Check-in lúc</th>
<th class="py-3 px-4 min-w-[140px]">Thời gian chờ</th>
<th class="py-3 px-4 min-w-[130px]">Trạng thái</th>
</tr>
</thead>
<tbody class="divide-y-0 text-on-surface font-body-sm text-body-sm">
@if (IsLoading)
{
<tr><td colspan="7" class="py-6 text-center text-on-surface-variant">Đang tải...</td></tr>
}
else if (FilteredQueue.Count == 0)
{
<tr><td colspan="7" class="py-6 text-center text-on-surface-variant">Hàng chờ trống</td></tr>
}
else
{
@foreach (var appt in FilteredQueue)
{
var waitMinutes = appt.CheckedInAt is not null ? (int)(DateTime.UtcNow - appt.CheckedInAt.Value).TotalMinutes : 0;
var isOverdue = waitMinutes > 30;
<tr class="hover:bg-surface-container-low transition-colors group @(isOverdue ? "bg-error-container/20 hover:bg-error-container/30" : "")">
<td class="py-3 px-4 text-center">
<span class="inline-flex items-center justify-center px-2.5 py-1 rounded-full @(isOverdue ? "bg-error-container text-on-error-container" : "bg-primary-container text-on-primary") font-headline-sm text-headline-sm font-black">#@appt.QueueNumber?.ToString("00")</span>
</td>
<td class="py-3 px-4">
<div class="flex flex-col">
<span class="font-title-md text-title-md font-bold text-on-surface">@appt.PatientName</span>
</div>
</td>
<td class="py-3 px-4">
<div class="flex flex-col">
<span class="font-label-md text-label-md font-bold text-on-surface">@appt.DoctorName</span>
<span class="font-label-xs text-label-xs text-on-surface-variant">@(DoctorRoom(appt.DoctorId) ?? "—")</span>
</div>
</td>
<td class="py-3 px-4">
<span class="font-label-md text-label-md font-medium text-on-surface">@ToLocal(appt.StartTime).ToString("HH:mm")</span>
</td>
<td class="py-3 px-4">
<span class="font-label-sm text-label-sm text-on-surface-variant">@(appt.CheckedInAt is not null ? ToLocal(appt.CheckedInAt.Value).ToString("HH:mm:ss") : "—")</span>
</td>
<td class="py-3 px-4">
<div class="flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full @(isOverdue ? "bg-error animate-ping" : "bg-secondary")"></span>
<span class="font-label-sm text-label-sm font-semibold @(isOverdue ? "text-error font-black" : "")">@waitMinutes phút</span>
</div>
</td>
<td class="py-3 px-4">
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-label-xs text-label-xs font-bold @(appt.Status == AppointmentStatus.InProgress ? "bg-primary-fixed text-on-primary-fixed-variant" : "bg-surface-container-high text-on-surface-variant")">
@(appt.Status == AppointmentStatus.InProgress ? "Đang khám" : "Đang chờ gọi")
</span>
</td>
</tr>
}
}
</tbody>
</table>
</div>
<div class="p-space-md bg-surface-container-low flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-on-surface-variant font-label-sm text-label-sm">
<div class="flex items-center gap-2">
<span>Tổng cộng <strong class="text-on-surface">@FilteredQueue.Count</strong> bệnh nhân trong hàng chờ</span>
</div>
</div>
</div>
</div>
</div>

@code {
    private DateOnly Today { get; } = DateOnly.FromDateTime(DateTime.Today);
    private List<AppointmentDto> Queue { get; set; } = new();
    private Dictionary<int, DoctorDto> DoctorsById { get; set; } = new();
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string SearchKeyword { get; set; } = "";

    private List<RoomQueueEntry> RoomQueues { get; set; } = new();

    private List<AppointmentDto> FilteredQueue => Queue
        .Where(a => string.IsNullOrWhiteSpace(SearchKeyword)
            || a.PatientName.Contains(SearchKeyword, StringComparison.OrdinalIgnoreCase)
            || a.DoctorName.Contains(SearchKeyword, StringComparison.OrdinalIgnoreCase)
            || (a.QueueNumber?.ToString() ?? "").Contains(SearchKeyword, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var appointments = await Api.GetAsync<PagedResult<AppointmentDto>>($"api/appointments?date={Today:yyyy-MM-dd}&pageSize=200");
            Queue = appointments.Items
                .Where(a => a.Status is AppointmentStatus.CheckedIn or AppointmentStatus.InProgress)
                .OrderBy(a => a.QueueNumber)
                .ToList();

            var doctors = await Api.GetAsync<PagedResult<DoctorDto>>("api/doctors?pageSize=100");
            DoctorsById = doctors.Items.ToDictionary(d => d.Id);

            RoomQueues = Queue
                .GroupBy(a => new { a.DoctorId, a.DoctorName })
                .Select(g => new RoomQueueEntry
                {
                    DoctorName = g.Key.DoctorName,
                    Room = DoctorRoom(g.Key.DoctorId),
                    Current = g.FirstOrDefault(a => a.Status == AppointmentStatus.InProgress),
                    Next = g.Where(a => a.Status == AppointmentStatus.CheckedIn).OrderBy(a => a.QueueNumber).FirstOrDefault(),
                    WaitingCount = g.Count(a => a.Status == AppointmentStatus.CheckedIn),
                })
                .ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string? DoctorRoom(int doctorId) => DoctorsById.TryGetValue(doctorId, out var d) ? d.Room : null;

    private static DateTime ToLocal(DateTime utc) => utc.AddHours(7);

    private class RoomQueueEntry
    {
        public string DoctorName { get; set; } = "";
        public string? Room { get; set; }
        public AppointmentDto? Current { get; set; }
        public AppointmentDto? Next { get; set; }
        public int WaitingCount { get; set; }
    }
}
