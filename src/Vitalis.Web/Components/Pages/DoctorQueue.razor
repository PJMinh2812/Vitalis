@page "/doctor/queue"
@layout DoctorLayout
@attribute [Authorize(Roles = "Doctor")]
@using Vitalis.Application.DTOs.Appointments
@using Vitalis.Application.Common
@using Vitalis.Domain.Enums
@inject VitalisApiClient Api
@inject AuthTokenStore TokenStore
@inject NavigationManager Navigation

<PageTitle>Hàng chờ khám · Vitalis</PageTitle>

<div class="flex flex-col w-full gap-space-lg">
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
<div class="flex flex-col gap-1 min-w-0">
<h1 class="font-headline-md text-headline-md text-on-surface font-bold tracking-tight">Hàng chờ khám bệnh</h1>
<p class="font-body-sm text-body-sm text-on-surface-variant truncate">Danh sách bệnh nhân đã tiếp đón, chờ vào khám hôm nay.</p>
</div>
<button class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm transition-colors shadow-sm shrink-0" type="button" @onclick="LoadAsync">
<span class="material-symbols-outlined text-[18px]">refresh</span>
<span>Làm mới</span>
</button>
</div>

@if (ErrorMessage is not null)
{
    <div class="p-4 rounded-xl bg-error-container text-on-error-container shadow-sm flex items-center gap-3">
        <span class="material-symbols-outlined text-error text-[22px]">warning</span>
        <p class="font-body-sm text-body-sm">@ErrorMessage</p>
    </div>
}

<div class="grid grid-cols-1 sm:grid-cols-3 gap-space-md">
<div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">Tổng ca hôm nay</span>
<span class="font-display text-display text-on-surface font-bold tracking-tight mt-1">@TodayAppointments.Count</span>
</div>
<div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">Đang chờ vào khám</span>
<span class="font-display text-display text-primary font-bold tracking-tight mt-1">@WaitingAppointments.Count</span>
</div>
<div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">Đã khám xong</span>
<span class="font-display text-display text-tertiary font-bold tracking-tight mt-1">@CompletedCount</span>
</div>
</div>

<div class="flex flex-col bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
<div class="p-space-md">
<div class="relative max-w-lg">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-outline">search</span>
<input class="w-full h-10 pl-10 pr-4 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-sm text-body-sm focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all" placeholder="Tìm theo tên bệnh nhân..." type="text" @bind="SearchTerm" @bind:event="oninput" />
</div>
</div>
<div class="overflow-x-auto w-full">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-low/70 text-on-surface-variant font-label-xs text-label-xs uppercase tracking-wider border-b border-surface-container">
<th class="py-3 px-4 w-16 text-center">STT</th>
<th class="py-3 px-4 min-w-[200px]">Bệnh nhân</th>
<th class="py-3 px-4 min-w-[130px]">Giờ check-in</th>
<th class="py-3 px-4 min-w-[220px]">Lý do khám</th>
<th class="py-3 px-4 min-w-[140px]">Trạng thái</th>
<th class="py-3 px-4 text-right min-w-[160px]">Thao tác</th>
</tr>
</thead>
<tbody class="divide-y divide-surface-container font-body-sm text-body-sm text-on-surface">
@if (IsLoading)
{
    <tr><td class="py-6 px-4 text-center text-on-surface-variant" colspan="6">Đang tải...</td></tr>
}
else if (FilteredQueue.Count == 0)
{
    <tr><td class="py-6 px-4 text-center text-on-surface-variant" colspan="6">Không có bệnh nhân nào đang chờ.</td></tr>
}
else
{
    @foreach (var appointment in FilteredQueue)
    {
        <tr class="hover:bg-primary-fixed/10 transition-colors">
            <td class="py-3.5 px-4 text-center">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-container text-on-primary font-bold font-mono text-[14px]">#@(appointment.QueueNumber?.ToString("D2") ?? "-")</span>
            </td>
            <td class="py-3.5 px-4">
                <span class="font-title-md text-title-md font-bold text-on-surface">@appointment.PatientName</span>
            </td>
            <td class="py-3.5 px-4">@(appointment.CheckedInAt?.ToLocalTime().ToString("HH:mm") ?? "-")</td>
            <td class="py-3.5 px-4">@appointment.Reason</td>
            <td class="py-3.5 px-4">@StatusLabel(appointment.Status)</td>
            <td class="py-3.5 px-4 text-right">
                <button class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm font-semibold shadow-sm transition-all disabled:opacity-50" type="button" disabled="@(BusyAppointmentId == appointment.Id)" @onclick="() => StartExamAsync(appointment.Id)">
                    <span>@(appointment.Status == AppointmentStatus.InProgress ? "Tiếp tục khám" : "Tiếp nhận")</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </button>
            </td>
        </tr>
    }
}
</tbody>
</table>
</div>
</div>
</div>

@code {
    private List<AppointmentDto> TodayAppointments { get; set; } = [];
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string SearchTerm { get; set; } = "";
    private int? BusyAppointmentId { get; set; }

    private List<AppointmentDto> WaitingAppointments =>
        TodayAppointments.Where(a => a.Status is AppointmentStatus.CheckedIn or AppointmentStatus.InProgress).ToList();

    private int CompletedCount => TodayAppointments.Count(a => a.Status == AppointmentStatus.Completed);

    private List<AppointmentDto> FilteredQueue =>
        WaitingAppointments
            .Where(a => string.IsNullOrWhiteSpace(SearchTerm) || a.PatientName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.QueueNumber)
            .ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Now);
            var result = await Api.GetAsync<PagedResult<AppointmentDto>>($"api/appointments?date={today:yyyy-MM-dd}&pageSize=100");
            TodayAppointments = result.Items.ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task StartExamAsync(int appointmentId)
    {
        BusyAppointmentId = appointmentId;
        ErrorMessage = null;
        try
        {
            await Api.PatchAsync<object?, Vitalis.Application.DTOs.MedicalRecords.MedicalRecordDto>($"api/appointments/{appointmentId}/start-exam", null);
            Navigation.NavigateTo($"/doctor/exam?appointmentId={appointmentId}");
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
            BusyAppointmentId = null;
        }
    }

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.CheckedIn => "Đã check-in",
        AppointmentStatus.InProgress => "Đang khám",
        AppointmentStatus.Completed => "Đã hoàn thành",
        AppointmentStatus.Cancelled => "Đã huỷ",
        AppointmentStatus.NoShow => "Không đến",
        _ => status.ToString(),
    };
}
