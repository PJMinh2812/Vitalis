@page "/register"
@layout AuthLayout
@inject VitalisApiClient Api
@inject AuthTokenStore TokenStore
@inject NavigationManager Navigation

<PageTitle>Đăng ký · Vitalis</PageTitle>

<div class="flex flex-col w-full">
<div class="flex flex-col lg:flex-row w-full min-h-[920px]">
<!-- LEFT PANEL: Teal Brand & Healthcare Value Proposition -->
<div class="relative flex flex-col justify-between w-full lg:w-1/2 bg-gradient-to-br from-primary-container via-primary to-[#064e48] p-8 md:p-14 lg:p-16 text-on-primary overflow-hidden">
<!-- Ambient organic shapes and medical grid glow -->
<div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-primary-fixed/10 blur-3xl pointer-events-none"></div>
<div class="absolute bottom-0 right-0 w-80 h-80 rounded-full bg-secondary/15 blur-2xl pointer-events-none"></div>
<!-- Top Branding -->
<div class="relative z-10 flex flex-col items-start space-y-4">
<div class="inline-flex items-center gap-3 bg-surface-container-lowest/15 backdrop-blur-md px-4 py-2 rounded-full">
<img alt="Vitalis Clinic Logo" class="h-9 w-auto object-contain brightness-0 invert" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAzohQN64ze0pNnjDokgq0MNHqeFRGGo9pjRMwN5rhtf00Xp05cS7kohESWk9XIuRHEQ0ZGB91T7zx7yx8FenusKFoodUvn1i3T5EWIR50aBG9J3y-V_2VxOR78Iu2RV69SgT1O9qlJ4q5RCl2HpPsBS96BSMmRNKFA-_vQltj8kaAmwUD3Mb_twCgQiadd1Pr0I2UKADADGWIu3ZOyPjjngM1og740F7j0O6nU-d61G-J_ehe7GJkQ"/>
<span class="font-headline-sm text-headline-sm text-surface-container-lowest tracking-tight">Vitalis Clinic</span>
</div>
<span class="inline-flex items-center gap-2 px-3 py-1 bg-primary-fixed-dim/20 text-on-tertiary-container text-label-xs font-label-xs uppercase tracking-wider rounded-full">
<span class="w-1.5 h-1.5 rounded-full bg-primary-fixed animate-ping"></span>
          Cổng thông tin sức khỏe số
        </span>
</div>
<!-- Center Narrative & Feature Highlights -->
<div class="relative z-10 my-10 lg:my-0 space-y-8 max-w-xl">
<div class="space-y-3">
<h1 class="font-display text-display text-surface-container-lowest">
            Đăng ký tài khoản Vitalis
          </h1>
<p class="font-body-lg text-body-lg text-on-tertiary-container/90 leading-relaxed">
            Chăm sóc sức khỏe thông minh &amp; đồng bộ hồ sơ bệnh án theo tiêu chuẩn y khoa quốc gia.
          </p>
</div>
<div class="space-y-4 pt-2">
<!-- Feature 1 -->
<div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container-lowest/10 backdrop-blur-sm shadow-sm transition-all hover:bg-surface-container-lowest/15">
<div class="flex items-center justify-center w-11 h-11 rounded-lg bg-surface-container-lowest/20 text-primary-fixed shrink-0">
<span class="material-symbols-outlined text-[24px]">clinical_notes</span>
</div>
<div class="flex flex-col">
<h3 class="font-title-md text-title-md text-surface-container-lowest">Xem kết quả khám &amp; đơn thuốc trực tuyến</h3>
<p class="font-body-sm text-body-sm text-on-tertiary-container/80 mt-0.5">Truy cập chỉ số xét nghiệm, chẩn đoán hình ảnh và lịch trình uống thuốc bất cứ khi nào.</p>
</div>
</div>
<!-- Feature 2 -->
<div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container-lowest/10 backdrop-blur-sm shadow-sm transition-all hover:bg-surface-container-lowest/15">
<div class="flex items-center justify-center w-11 h-11 rounded-lg bg-surface-container-lowest/20 text-primary-fixed shrink-0">
<span class="material-symbols-outlined text-[24px]">event_upcoming</span>
</div>
<div class="flex flex-col">
<h3 class="font-title-md text-title-md text-surface-container-lowest">Nhắc lịch hẹn khám tự động</h3>
<p class="font-body-sm text-body-sm text-on-tertiary-container/80 mt-0.5">Chủ động đặt lịch bác sĩ chuyên khoa và nhận cảnh báo tái khám qua Zalo/SMS kịp thời.</p>
</div>
</div>
<!-- Feature 3 -->
<div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container-lowest/10 backdrop-blur-sm shadow-sm transition-all hover:bg-surface-container-lowest/15">
<div class="flex items-center justify-center w-11 h-11 rounded-lg bg-surface-container-lowest/20 text-primary-fixed shrink-0">
<span class="material-symbols-outlined text-[24px]">verified_user</span>
</div>
<div class="flex flex-col">
<h3 class="font-title-md text-title-md text-surface-container-lowest">Bảo mật &amp; liên kết mã số bệnh nhân duy nhất</h3>
<p class="font-body-sm text-body-sm text-on-tertiary-container/80 mt-0.5">Tự động nhận diện hồ sơ cũ qua số điện thoại cá nhân, tránh trùng lặp dữ liệu khám chữa.</p>
</div>
</div>
</div>
</div>
<!-- Bottom Trust Badges -->
<div class="relative z-10 pt-6 flex items-center justify-between text-on-tertiary-container/70 text-label-xs font-label-xs">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-[18px]">verified</span>
<span>Chứng nhận An toàn Thông tin Y tế ISO 27001</span>
</div>
<span>Hotline 24/7: 1900 6868</span>
</div>
</div>
<!-- RIGHT PANEL: Registration Workspace -->
<div class="flex flex-col items-center justify-center w-full lg:w-1/2 p-6 sm:p-10 lg:p-12 bg-surface-bright">
<div class="w-full max-w-[520px] bg-surface-container-lowest rounded-xl shadow-md p-8 sm:p-10 space-y-6">
<!-- Header -->
<div class="space-y-1">
<div class="flex items-center justify-between">
<h2 class="font-headline-md text-headline-md text-on-surface">Đăng ký tài khoản</h2>
<span class="px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-xs text-label-xs">Dành cho bệnh nhân</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant">
            Dành cho bệnh nhân đăng ký khám tại hệ thống phòng khám Vitalis
          </p>
</div>
<form class="space-y-4" id="patient-registration-form" @onsubmit="HandleRegisterAsync" @onsubmit:preventDefault="true">
@if (ErrorMessage is not null)
{
<div class="flex items-start gap-3 p-3.5 rounded-lg bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-[20px] shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@ErrorMessage</p>
</div>
}
<!-- Field 1: Họ và tên -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="fullName">
              Họ và tên <span class="text-error">*</span>
</label>
<div class="relative">
<input class="w-full h-10 px-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="fullName" name="fullName" placeholder="Ví dụ: Nguyễn Văn An" type="text" @bind="FullName"/>
<span class="material-symbols-outlined absolute right-3 top-2.5 text-[20px] text-outline">badge</span>
</div>
</div>
<!-- Field 2: Số điện thoại + Inline Profile Check Button -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="phone">
              Số điện thoại <span class="text-error">*</span>
</label>
<div class="flex items-center gap-2">
<div class="relative flex-1">
<input class="w-full h-10 px-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="phone" name="phone" placeholder="Nhập số điện thoại đăng ký" type="tel" @bind="Phone"/>
<span class="material-symbols-outlined absolute right-3 top-2.5 text-[20px] text-outline">call</span>
</div>
<button class="h-10 px-4 shrink-0 bg-surface-container-lowest text-primary font-label-md text-label-md rounded-lg shadow-sm hover:bg-primary-fixed/20 active:bg-primary-fixed/30 transition-colors inline-flex items-center gap-1.5 disabled:opacity-60" disabled="@IsCheckingProfile" type="button" @onclick="CheckProfileAsync">
<span class="material-symbols-outlined text-[18px]">manage_search</span>
<span>Kiểm tra hồ sơ</span>
</button>
</div>
</div>
<!-- Dynamic Profile Search Feedback (VC-02: GET /api/patients/lookup?phone=) -->
@if (LookupResult is not null)
{
@if (LookupResult.Found)
{
<div class="flex items-start gap-3 p-3.5 rounded-lg bg-[#DCFCE7] text-[#166534] shadow-sm">
<span class="material-symbols-outlined text-[20px] text-[#166534] mt-0.5 shrink-0" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<div class="flex-1 text-label-sm font-label-sm leading-relaxed">
<span class="font-title-md text-title-md block text-[#166534] mb-0.5">Tìm thấy hồ sơ khám trước đây:</span>
                Bệnh nhân <strong class="font-title-md text-title-md">@LookupResult.MaskedName</strong>, mã hồ sơ <span class="bg-[#BBF7D0] px-1.5 py-0.5 rounded font-mono font-bold">@LookupResult.PatientCode</span>. Tài khoản mới sẽ được liên kết với hồ sơ này để đồng bộ lịch sử khám chữa bệnh.
              </div>
</div>
}
else
{
<div class="flex items-start gap-3 p-3.5 rounded-lg bg-surface-container text-on-surface-variant shadow-sm">
<span class="material-symbols-outlined text-[20px] text-secondary mt-0.5 shrink-0">info</span>
<div class="flex-1 text-label-sm font-label-sm leading-relaxed">
<span class="font-title-md text-title-md block text-on-surface mb-0.5">Hồ sơ bệnh nhân mới:</span>
                Không tìm thấy hồ sơ liên kết với số điện thoại này. Một mã hồ sơ bệnh án điện tử mới sẽ được tạo tự động ngay sau khi hoàn tất đăng ký.
              </div>
</div>
}
}
<!-- Dual Column: Email & Ngày sinh -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<!-- Field 4: Email -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="email">
                Email
              </label>
<div class="relative">
<input class="w-full h-10 px-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="email" name="email" placeholder="name@@example.com" type="email" @bind="Email"/>
<span class="material-symbols-outlined absolute right-3 top-2.5 text-[20px] text-outline">mail</span>
</div>
</div>
<!-- Field 5: Ngày sinh -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="dob">
                Ngày sinh
              </label>
<div class="relative">
<input class="w-full h-10 px-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="dob" name="dob" type="date" @bind="DateOfBirth"/>
<span class="material-symbols-outlined absolute right-3 top-2.5 text-[20px] text-outline">calendar_month</span>
</div>
</div>
</div>
<!-- Dual Column: Mật khẩu & Nhập lại mật khẩu -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<!-- Field 6: Mật khẩu -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="password">
                Mật khẩu <span class="text-error">*</span>
</label>
<div class="relative">
<input class="w-full h-10 px-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="password" name="password" placeholder="Tối thiểu 8 ký tự" type="password" @bind="Password"/>
<button class="absolute right-3 top-2.5 text-outline hover:text-on-surface" onclick="togglePasswordVisibility('password', this)" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">Tối thiểu 8 ký tự, gồm chữ và số</p>
</div>
<!-- Field 7: Nhập lại mật khẩu -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="confirmPassword">
                Nhập lại mật khẩu <span class="text-error">*</span>
</label>
<div class="relative">
<input class="w-full h-10 px-3 py-2 bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-lg focus:outline-none focus:ring-2 focus:ring-primary shadow-sm" id="confirmPassword" name="confirmPassword" placeholder="Xác nhận mật khẩu" type="password" @bind="ConfirmPassword"/>
<button class="absolute right-3 top-2.5 text-outline hover:text-on-surface" onclick="togglePasswordVisibility('confirmPassword', this)" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
@if (Password.Length > 0 && ConfirmPassword.Length > 0 && Password != ConfirmPassword)
{
<p class="font-body-sm text-body-sm text-error flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-[16px]">error</span>
<span>Mật khẩu nhập lại không khớp</span>
</p>
}
</div>
</div>
<!-- Field 9: Terms agreement checkbox -->
<div class="pt-2">
<label class="flex items-start gap-3 cursor-pointer group">
<input class="mt-1 w-4 h-4 text-primary rounded bg-surface-container-lowest focus:ring-primary accent-primary cursor-pointer shrink-0" id="terms" type="checkbox" @bind="AgreedToTerms"/>
<span class="font-body-sm text-body-sm text-on-surface-variant group-hover:text-on-surface select-none">
                Tôi đồng ý với <a class="text-primary font-label-md text-label-md hover:underline" href="#">Điều khoản sử dụng</a> và <a class="text-primary font-label-md text-label-md hover:underline" href="#">Chính sách bảo mật dữ liệu y tế</a> của hệ thống Vitalis.
              </span>
</label>
</div>
<!-- Field 10: Primary Registration Action Button -->
<div class="pt-2">
<button class="w-full h-11 px-4 bg-primary text-on-primary font-label-md text-label-md rounded-lg shadow-md hover:bg-primary-container active:bg-primary transition-all flex items-center justify-center gap-2 group disabled:opacity-60" disabled="@IsBusy" type="submit">
<span>@(IsBusy ? "Đang đăng ký..." : "Đăng ký tài khoản")</span>
<span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
</div>
<!-- Field 11: Footer login redirection -->
<div class="text-center pt-2">
<p class="font-body-sm text-body-sm text-on-surface-variant">
              Đã có tài khoản khám bệnh?
              <a class="font-title-md text-title-md text-primary hover:underline ml-1" href="/login">Đăng nhập ngay</a>
</p>
</div>
</form>
</div>
</div>
</div>

</div>
<script src="js/pages/Register.js"></script>

@code {
    private string FullName { get; set; } = "";
    private string Phone { get; set; } = "";
    private string Email { get; set; } = "";
    private DateOnly? DateOfBirth { get; set; }
    private string Password { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private bool AgreedToTerms { get; set; }

    private bool IsCheckingProfile { get; set; }
    private Vitalis.Application.DTOs.Patients.PatientLookupResult? LookupResult { get; set; }

    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }

    // VC-02: pre-login lookup so the patient can see their old walk-in profile
    // will be linked, before they even submit the form.
    private async Task CheckProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(Phone))
            return;

        IsCheckingProfile = true;
        try
        {
            LookupResult = await Api.GetAsync<Vitalis.Application.DTOs.Patients.PatientLookupResult>(
                $"api/patients/lookup?phone={Uri.EscapeDataString(Phone)}");
        }
        catch (ApiException)
        {
            LookupResult = null;
        }
        finally
        {
            IsCheckingProfile = false;
        }
    }

    private async Task HandleRegisterAsync()
    {
        ErrorMessage = null;

        if (!AgreedToTerms)
        {
            ErrorMessage = "Bạn cần đồng ý với Điều khoản sử dụng để tiếp tục.";
            return;
        }
        if (Password != ConfirmPassword)
        {
            ErrorMessage = "Mật khẩu nhập lại không khớp.";
            return;
        }

        IsBusy = true;
        try
        {
            var request = new RegisterPatientRequest
            {
                FullName = FullName,
                Phone = Phone,
                Email = string.IsNullOrWhiteSpace(Email) ? null : Email,
                DateOfBirth = DateOfBirth,
                Password = Password,
            };
            var response = await Api.RegisterAsync(request);
            TokenStore.SetSession(response.AccessToken, response.RefreshToken, response.User);
            Navigation.NavigateTo("/my-appointments");
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}
