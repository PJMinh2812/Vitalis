@page "/reception/booking"
@layout ReceptionLayout
@attribute [Authorize(Roles = "Receptionist")]
@inject VitalisApiClient Api
@inject AuthTokenStore TokenStore
@using Vitalis.Application.Common
@using Vitalis.Application.DTOs.Appointments
@using Vitalis.Application.DTOs.Doctors
@using Vitalis.Application.DTOs.Patients
@using Vitalis.Domain.Enums

<PageTitle>Đặt lịch hộ · Vitalis</PageTitle>

<div class="flex flex-col w-full">
@if (SuccessAppointment is not null)
{
<div class="fixed top-20 right-8 z-50 max-w-md w-full bg-surface-container-lowest shadow-xl rounded-xl p-4 flex items-start gap-3 transition-all duration-300">
<div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between">
<h4 class="font-title-md text-title-md text-on-surface">Đặt lịch thành công!</h4>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
        Mã phiếu: <span class="font-semibold text-primary">@SuccessAppointment.AppointmentCode</span> cho bệnh nhân <span class="font-semibold text-on-surface">@SuccessAppointment.PatientName</span>.
      </p>
</div>
<button class="text-on-surface-variant hover:text-on-surface p-1 rounded transition-colors" @onclick="() => SuccessAppointment = null">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
}
<!-- Main Content Workspace -->
<div class="px-space-xl py-space-lg flex flex-col gap-space-lg">
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
<div>
<div class="flex items-center gap-2 mb-1">
<span class="font-label-xs text-label-xs px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-bold uppercase tracking-wider">Lễ tân tác vụ</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Đặt lịch hẹn khám hộ / Tiếp nhận vãng lai</h1>
<p class="font-body-md text-body-md text-on-surface-variant mt-0.5">Hỗ trợ đặt hẹn khám nhanh qua điện thoại hoặc tiếp đón trực tiếp tại quầy</p>
</div>
<div class="flex items-center gap-3 bg-surface-container-low px-4 py-2.5 rounded-xl self-start md:self-auto">
<div class="w-2.5 h-2.5 rounded-full bg-primary-container animate-pulse"></div>
<span class="font-label-sm text-label-sm text-on-surface-variant">Nhân viên trực: <strong class="text-on-surface">@(TokenStore.CurrentUser?.FullName ?? "—")</strong></span>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
<!-- LEFT COLUMN -->
<div class="lg:col-span-8 flex flex-col gap-space-lg">
<!-- CARD 1: Bệnh nhân -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2.5">
<span class="w-7 h-7 rounded-lg bg-primary-container text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold">1</span>
<h2 class="font-title-md text-title-md text-on-surface">Thông tin Bệnh nhân &amp; Kênh tiếp nhận</h2>
</div>
<button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-primary font-label-sm text-label-sm font-semibold transition-colors" @onclick="() => ShowQuickPatientModal = true" type="button">
<span class="material-symbols-outlined text-[18px]">person_add</span>
<span>+ Tạo nhanh bệnh nhân</span>
</button>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Nguồn đặt hẹn tiếp nhận <span class="text-error">*</span></label>
<div class="grid grid-cols-2 gap-3 p-1 bg-surface-container-low rounded-xl">
<label class="flex items-center justify-center gap-2.5 py-2.5 px-4 rounded-lg cursor-pointer transition-all font-label-md text-label-md @(Source == AppointmentSource.WalkIn ? "bg-surface-container-lowest shadow-sm text-primary" : "text-on-surface-variant hover:text-on-surface")">
<input class="hidden" name="booking_source" type="radio" checked="@(Source == AppointmentSource.WalkIn)" @onchange="() => Source = AppointmentSource.WalkIn"/>
<span class="material-symbols-outlined text-[18px]">storefront</span>
<span class="font-semibold">Trực tiếp tại quầy tiếp đón</span>
</label>
<label class="flex items-center justify-center gap-2.5 py-2.5 px-4 rounded-lg cursor-pointer transition-all font-label-md text-label-md @(Source == AppointmentSource.Phone ? "bg-surface-container-lowest shadow-sm text-primary" : "text-on-surface-variant hover:text-on-surface")">
<input class="hidden" name="booking_source" type="radio" checked="@(Source == AppointmentSource.Phone)" @onchange="() => Source = AppointmentSource.Phone"/>
<span class="material-symbols-outlined text-[18px]">support_agent</span>
<span>Qua điện thoại (Hotline 1900 6868)</span>
</label>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface">Bệnh nhân được đặt hẹn <span class="text-error">*</span></label>
@if (SelectedPatient is null)
{
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-[18px]">search</span>
<input class="w-full h-10 pl-9 pr-3 rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Tìm theo tên, SĐT hoặc mã BN..." type="text" @bind="PatientKeyword" @bind:event="oninput" @onkeyup="SearchPatientsAsync"/>
</div>
@if (PatientResults.Count > 0)
{
<div class="flex flex-col gap-1.5 max-h-64 overflow-y-auto">
@foreach (var p in PatientResults)
{
<button type="button" class="p-3 bg-surface-container-low rounded-lg flex items-center justify-between hover:bg-surface-container-high transition-colors text-left" @onclick="() => SelectPatient(p)">
<div class="flex flex-col min-w-0">
<span class="font-label-md text-label-md font-bold text-on-surface">@p.FullName</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">@p.PatientCode · @p.Phone</span>
</div>
</button>
}
</div>
}
}
else
{
<div class="p-3.5 bg-surface-container-low rounded-xl flex items-center justify-between">
<div class="flex items-center gap-3 min-w-0">
<div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[22px]">badge</span>
</div>
<div class="flex flex-col min-w-0">
<div class="flex items-center gap-2 flex-wrap">
<span class="font-label-md text-label-md font-bold text-on-surface">@SelectedPatient.FullName</span>
<span class="px-2 py-0.5 rounded-full bg-surface-container font-label-xs text-label-xs text-on-surface-variant font-semibold">@SelectedPatient.PatientCode</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">@SelectedPatient.Phone</span>
</div>
</div>
</div>
<div class="flex items-center gap-2 shrink-0">
<button type="button" class="px-3 py-1.5 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold shadow-sm transition-colors flex items-center gap-1" @onclick="() => SelectedPatient = null">
<span class="material-symbols-outlined text-[16px]">sync_alt</span>
<span>Thay đổi</span>
</button>
</div>
</div>
}
</div>
</div>
<!-- CARD 2: Chuyên khoa & Bác sĩ -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center gap-2.5">
<span class="w-7 h-7 rounded-lg bg-primary-container text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold">2</span>
<h2 class="font-title-md text-title-md text-on-surface">Chuyên khoa &amp; Bác sĩ phụ trách</h2>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Chuyên khoa khám bệnh <span class="text-error">*</span></label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-2.5 text-primary text-[20px]">medical_services</span>
<select class="w-full h-11 pl-10 pr-10 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none appearance-none cursor-pointer" @bind="SelectedSpecialtyId" @bind:after="OnSpecialtyChangedAsync">
<option value="0">-- Chọn chuyên khoa --</option>
@foreach (var s in Specialties)
{
<option value="@s.Id">@s.Name</option>
}
</select>
</div>
</div>
<div class="flex flex-col gap-2 pt-1">
<div class="flex items-center justify-between">
<label class="font-label-md text-label-md text-on-surface">Bác sĩ khám trực ca <span class="text-error">*</span></label>
<span class="font-label-xs text-label-xs text-on-surface-variant">@Doctors.Count bác sĩ</span>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
@foreach (var d in Doctors)
{
<div class="p-3.5 rounded-xl flex flex-col justify-between gap-3 relative cursor-pointer transition-all @(SelectedDoctor?.Id == d.Id ? "bg-primary/5 shadow-md ring-2 ring-primary-container" : "bg-surface-container-low hover:bg-surface-container-high")" @onclick="() => SelectDoctorAsync(d)">
@if (SelectedDoctor?.Id == d.Id)
{
<div class="absolute top-3 right-3 text-primary-container">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
}
<div class="flex flex-col min-w-0 pr-6">
<span class="font-label-md text-label-md font-bold text-on-surface truncate">@d.FullName</span>
<span class="font-label-xs text-label-xs text-on-surface-variant">@d.Title</span>
</div>
<div class="flex flex-col gap-1 pt-1 bg-surface-container-lowest/60 p-2 rounded-lg">
<div class="flex items-center justify-between text-label-xs font-label-xs text-on-surface-variant">
<span>Phòng khám:</span>
<span class="font-semibold text-on-surface">@(d.Room ?? "—")</span>
</div>
<div class="flex items-center justify-between text-label-xs font-label-xs text-on-surface-variant">
<span>Phí dịch vụ:</span>
<span class="font-bold text-primary">@FormatCurrency(d.ConsultationFee ?? 0)</span>
</div>
</div>
</div>
}
</div>
</div>
</div>
<!-- CARD 3: Ngày & Giờ -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center gap-2.5">
<span class="w-7 h-7 rounded-lg bg-primary-container text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold">3</span>
<h2 class="font-title-md text-title-md text-on-surface">Ngày khám &amp; Khung giờ</h2>
</div>
<div class="flex flex-col gap-1.5">
<span class="font-label-sm text-label-sm text-on-surface-variant">Chọn ngày trong tuần</span>
<div class="grid grid-cols-7 gap-2 overflow-x-auto pb-1">
@foreach (var day in NextDays)
{
<button type="button" class="flex flex-col items-center justify-center py-2.5 px-1 rounded-xl transition-all @(day == SelectedDate ? "bg-primary-container text-on-primary shadow-sm" : "bg-surface-container-low hover:bg-surface-container text-on-surface")" @onclick="() => SelectDateAsync(day)">
<span class="font-label-xs text-label-xs uppercase opacity-85">@(day == Today ? "Hôm nay" : day.ToString("ddd"))</span>
<span class="font-title-md text-title-md font-bold mt-0.5">@day.ToString("dd/MM")</span>
</button>
}
</div>
</div>
<div class="flex flex-col gap-space-sm pt-2">
@if (SelectedDoctor is null)
{
<p class="font-body-sm text-body-sm text-on-surface-variant">Vui lòng chọn bác sĩ trước.</p>
}
else if (Slots.Count == 0)
{
<p class="font-body-sm text-body-sm text-on-surface-variant">Không có khung giờ nào trong ngày này.</p>
}
else
{
<div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
@foreach (var slot in Slots)
{
<button type="button" disabled="@(!slot.IsAvailable)" class="py-2 rounded-lg font-label-md text-label-md text-center transition-colors @SlotClass(slot)" @onclick="() => SelectedSlot = slot">
@slot.StartTime.ToString("HH:mm")
</button>
}
</div>
}
</div>
</div>
<!-- CARD 4: Ghi chú -->
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center gap-2.5">
<span class="w-7 h-7 rounded-lg bg-primary-container text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold">4</span>
<h2 class="font-title-md text-title-md text-on-surface">Ghi chú tiếp nhận &amp; Triệu chứng ban đầu</h2>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface">Lý do khám / Triệu chứng bệnh nhân mô tả <span class="text-error">*</span></label>
<textarea class="w-full p-3 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary placeholder:text-outline" placeholder="Nhập tóm tắt mô tả bệnh nhân..." rows="3" @bind="Reason"></textarea>
</div>
</div>
</div>
<!-- RIGHT COLUMN: Summary -->
<div class="lg:col-span-4 sticky top-20 flex flex-col gap-space-md">
<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-md flex flex-col gap-space-md">
<div class="flex items-center justify-between pb-2">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[22px]">receipt_long</span>
<h3 class="font-title-md text-title-md text-on-surface">Tóm tắt phiếu đặt hẹn</h3>
</div>
</div>
@if (ErrorMessage is not null)
{
<div class="p-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@ErrorMessage</div>
}
<div class="flex flex-col gap-3 py-2 bg-surface-container-low/70 rounded-xl p-3.5">
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant">Bệnh nhân:</span>
<span class="font-label-md text-label-md font-bold text-on-surface block">@(SelectedPatient?.FullName ?? "Chưa chọn")</span>
</div>
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant">Bác sĩ phụ trách:</span>
<span class="font-label-md text-label-md font-bold text-on-surface block">@(SelectedDoctor?.FullName ?? "Chưa chọn")</span>
</div>
<div class="flex items-start justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant">Thời gian hẹn:</span>
<span class="font-label-md text-label-md font-bold text-primary block">@(SelectedSlot is not null ? $"{SelectedSlot.StartTime:HH:mm} - {SelectedDate:dd/MM/yyyy}" : "Chưa chọn")</span>
</div>
<div class="pt-2 flex items-center justify-between">
<span class="font-title-md text-title-md font-bold text-on-surface">Phí khám dự kiến:</span>
<span class="font-headline-sm text-headline-sm font-bold text-primary">@FormatCurrency(SelectedDoctor?.ConsultationFee ?? 0)</span>
</div>
</div>
<div class="flex flex-col gap-2 pt-2">
<button type="button" class="w-full py-3 px-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-60" disabled="@(IsBusy || !CanSubmit)" @onclick="SubmitAsync">
<span class="material-symbols-outlined text-[20px]">check_circle</span>
<span>@(IsBusy ? "Đang xử lý..." : "Xác nhận đặt lịch hẹn")</span>
</button>
<button type="button" class="w-full py-2.5 px-4 rounded-xl bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant font-label-md text-label-md font-semibold transition-colors flex items-center justify-center gap-1.5" @onclick="ResetForm">
<span class="material-symbols-outlined text-[18px]">restart_alt</span>
<span>Hủy &amp; Làm lại biểu mẫu</span>
</button>
</div>
</div>
</div>
</div>
</div>
</div>

@if (ShowQuickPatientModal)
{
<div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/40 backdrop-blur-sm p-4">
<div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-md p-space-lg flex flex-col gap-4">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[22px]">person_add</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Tạo nhanh Bệnh nhân</h3>
</div>
<button class="p-1 rounded-lg text-on-surface-variant hover:bg-surface-container-low" @onclick="CloseQuickPatientModal">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
@if (QuickCreateError is not null)
{
<div class="p-2.5 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@QuickCreateError</div>
}
<div class="flex flex-col gap-3">
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Họ và tên bệnh nhân <span class="text-error">*</span></label>
<input class="w-full h-10 px-3 rounded-lg bg-surface-container-low text-on-surface font-body-sm focus:outline-none focus:ring-1 focus:ring-primary" placeholder="VÍ DỤ: TRẦN THỊ HỒNG" type="text" @bind="QuickFullName"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Số điện thoại liên hệ <span class="text-error">*</span></label>
<input class="w-full h-10 px-3 rounded-lg bg-surface-container-low text-on-surface font-body-sm focus:outline-none focus:ring-1 focus:ring-primary" placeholder="09xx xxx xxx" type="tel" @bind="QuickPhone"/>
</div>
</div>
<div class="flex items-center justify-end gap-2 pt-2">
<button class="px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container font-label-md text-label-md text-on-surface" @onclick="CloseQuickPatientModal">Hủy bỏ</button>
<button class="px-4 py-2 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-semibold hover:bg-primary disabled:opacity-60" disabled="@IsQuickCreating" @onclick="QuickCreatePatientAsync">Lưu &amp; Áp dụng</button>
</div>
</div>
</div>
}

@code {
    private DateOnly Today { get; } = DateOnly.FromDateTime(DateTime.Today);
    private List<DateOnly> NextDays => Enumerable.Range(0, 7).Select(Today.AddDays).ToList();

    private AppointmentSource Source { get; set; } = AppointmentSource.WalkIn;

    private string PatientKeyword { get; set; } = "";
    private List<PatientDto> PatientResults { get; set; } = new();
    private PatientDto? SelectedPatient { get; set; }

    private List<Vitalis.Application.DTOs.Doctors.SpecialtyDto> Specialties { get; set; } = new();
    private int SelectedSpecialtyId { get; set; }

    private List<DoctorDto> Doctors { get; set; } = new();
    private DoctorDto? SelectedDoctor { get; set; }

    private DateOnly SelectedDate { get; set; }
    private List<SlotDto> Slots { get; set; } = new();
    private SlotDto? SelectedSlot { get; set; }

    private string Reason { get; set; } = "";
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private AppointmentDto? SuccessAppointment { get; set; }

    private bool ShowQuickPatientModal { get; set; }
    private string QuickFullName { get; set; } = "";
    private string QuickPhone { get; set; } = "";
    private bool IsQuickCreating { get; set; }
    private string? QuickCreateError { get; set; }

    private bool CanSubmit => SelectedPatient is not null && SelectedDoctor is not null && SelectedSlot is not null && !string.IsNullOrWhiteSpace(Reason);

    protected override async Task OnInitializedAsync()
    {
        SelectedDate = Today;
        try
        {
            Specialties = (await Api.GetAsync<IReadOnlyList<Vitalis.Application.DTOs.Doctors.SpecialtyDto>>("api/specialties?active=true")).ToList();
        }
        catch (ApiException)
        {
            Specialties = new();
        }
    }

    private async Task SearchPatientsAsync()
    {
        if (string.IsNullOrWhiteSpace(PatientKeyword))
        {
            PatientResults = new();
            return;
        }

        try
        {
            var result = await Api.GetAsync<PagedResult<PatientDto>>($"api/patients?keyword={Uri.EscapeDataString(PatientKeyword)}&pageSize=10");
            PatientResults = result.Items.ToList();
        }
        catch (ApiException)
        {
            PatientResults = new();
        }
    }

    private void SelectPatient(PatientDto patient)
    {
        SelectedPatient = patient;
        PatientResults = new();
        PatientKeyword = "";
    }

    private async Task OnSpecialtyChangedAsync()
    {
        SelectedDoctor = null;
        Slots = new();
        SelectedSlot = null;
        if (SelectedSpecialtyId <= 0)
        {
            Doctors = new();
            return;
        }

        try
        {
            var result = await Api.GetAsync<PagedResult<DoctorDto>>($"api/doctors?specialtyId={SelectedSpecialtyId}&pageSize=50");
            Doctors = result.Items.ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task SelectDoctorAsync(DoctorDto doctor)
    {
        SelectedDoctor = doctor;
        SelectedSlot = null;
        await LoadSlotsAsync();
    }

    private async Task SelectDateAsync(DateOnly date)
    {
        SelectedDate = date;
        SelectedSlot = null;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        if (SelectedDoctor is null)
        {
            Slots = new();
            return;
        }

        try
        {
            Slots = (await Api.GetAsync<IReadOnlyList<SlotDto>>($"api/doctors/{SelectedDoctor.Id}/available-slots?date={SelectedDate:yyyy-MM-dd}")).ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
            Slots = new();
        }
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit || SelectedPatient is null || SelectedDoctor is null || SelectedSlot is null)
            return;

        IsBusy = true;
        ErrorMessage = null;
        try
        {
            var startTime = SelectedDate.ToDateTime(SelectedSlot.StartTime).AddHours(-7);
            var request = new CreateAppointmentRequest(SelectedPatient.Id, SelectedDoctor.Id, startTime, Reason, Source);
            SuccessAppointment = await Api.PostAsync<CreateAppointmentRequest, AppointmentDto>("api/appointments", request);
            ResetForm();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ResetForm()
    {
        SelectedPatient = null;
        SelectedSpecialtyId = 0;
        Doctors = new();
        SelectedDoctor = null;
        SelectedDate = Today;
        Slots = new();
        SelectedSlot = null;
        Reason = "";
    }

    private void CloseQuickPatientModal()
    {
        ShowQuickPatientModal = false;
        QuickFullName = "";
        QuickPhone = "";
        QuickCreateError = null;
    }

    private async Task QuickCreatePatientAsync()
    {
        if (string.IsNullOrWhiteSpace(QuickFullName) || string.IsNullOrWhiteSpace(QuickPhone))
        {
            QuickCreateError = "Vui lòng nhập đầy đủ họ tên và số điện thoại.";
            return;
        }

        IsQuickCreating = true;
        QuickCreateError = null;
        try
        {
            var request = new QuickCreatePatientRequest { FullName = QuickFullName, Phone = QuickPhone };
            var patient = await Api.PostAsync<QuickCreatePatientRequest, PatientDto>("api/patients/quick", request);
            SelectedPatient = patient;
            CloseQuickPatientModal();
        }
        catch (ApiException ex)
        {
            QuickCreateError = ex.Message;
        }
        finally
        {
            IsQuickCreating = false;
        }
    }

    private static string FormatCurrency(decimal amount) =>
        amount.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + "đ";

    private string SlotClass(SlotDto slot)
    {
        if (!slot.IsAvailable)
            return "bg-surface-dim/50 text-outline cursor-not-allowed line-through opacity-70";

        if (SelectedSlot == slot)
            return "bg-primary-container text-on-primary font-bold shadow-sm";

        return "bg-surface-container text-on-surface hover:bg-surface-container-high";
    }
}
