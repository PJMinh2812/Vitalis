@code {
    private List<DoctorDto> AllDoctors { get; set; } = [];
    private List<SpecialtyDto> Specialties { get; set; } = [];
    private bool IsLoadingDoctors { get; set; }
    private bool IsSaving { get; set; }
    private string? ErrorMessage { get; set; }
    private string DoctorKeyword { get; set; } = "";

    private bool ShowCreateDoctorForm { get; set; }
    private DoctorFormModel NewDoctor { get; set; } = new();

    private DoctorDto? SelectedDoctor { get; set; }
    private List<DoctorScheduleDto> Schedules { get; set; } = [];
    private List<DoctorTimeOffDto> TimeOffs { get; set; } = [];
    private IReadOnlyList<ConflictingAppointmentDto>? LastConflicts { get; set; }
    private bool IsSavingSchedule { get; set; }
    private bool IsSavingTimeOff { get; set; }
    private ScheduleFormModel NewSchedule { get; set; } = new();
    private TimeOffFormModel NewTimeOff { get; set; } = new();

    private List<DoctorDto> FilteredDoctors => string.IsNullOrWhiteSpace(DoctorKeyword)
        ? AllDoctors
        : AllDoctors.Where(d => d.FullName.Contains(DoctorKeyword, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        IsLoadingDoctors = true;
        try
        {
            var page = await Api.GetAsync<PagedResult<DoctorDto>>("api/doctors?page=1&pageSize=200");
            AllDoctors = page.Items.ToList();
            Specialties = (await Api.GetAsync<IReadOnlyList<SpecialtyDto>>("api/specialties")).ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoadingDoctors = false;
        }
    }

    private void OpenCreateDoctorForm()
    {
        NewDoctor = new DoctorFormModel();
        ErrorMessage = null;
        ShowCreateDoctorForm = true;
    }

    private async Task CreateDoctorAsync()
    {
        IsSaving = true;
        try
        {
            var request = new DoctorRequest(
                NewDoctor.FullName,
                string.IsNullOrWhiteSpace(NewDoctor.Title) ? null : NewDoctor.Title,
                NewDoctor.SpecialtyId,
                string.IsNullOrWhiteSpace(NewDoctor.LicenseNumber) ? null : NewDoctor.LicenseNumber,
                string.IsNullOrWhiteSpace(NewDoctor.Room) ? null : NewDoctor.Room,
                NewDoctor.ConsultationFee,
                NewDoctor.MaxPatientsPerDay,
                NewDoctor.Username,
                NewDoctor.Password);
            var created = await Api.PostAsync<DoctorRequest, DoctorDto>("api/admin/doctors", request);
            AllDoctors.Add(created);
            ShowCreateDoctorForm = false;
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeactivateDoctorAsync(int id)
    {
        try
        {
            await Api.PatchNoContentAsync<object?>($"api/admin/doctors/{id}/deactivate", null);
            var index = AllDoctors.FindIndex(d => d.Id == id);
            if (index >= 0)
                AllDoctors[index] = AllDoctors[index] with { IsActive = false };
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task SelectDoctorAsync(DoctorDto doctor)
    {
        SelectedDoctor = doctor;
        LastConflicts = null;
        NewSchedule = new ScheduleFormModel();
        NewTimeOff = new TimeOffFormModel();
        ErrorMessage = null;
        try
        {
            Schedules = (await Api.GetAsync<IReadOnlyList<DoctorScheduleDto>>($"api/admin/doctor-schedules?doctorId={doctor.Id}")).ToList();
            TimeOffs = (await Api.GetAsync<IReadOnlyList<DoctorTimeOffDto>>($"api/admin/time-off?doctorId={doctor.Id}")).ToList();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task CreateScheduleAsync()
    {
        if (SelectedDoctor is null)
            return;
        IsSavingSchedule = true;
        try
        {
            var request = new ScheduleRequest(
                SelectedDoctor.Id,
                NewSchedule.DayOfWeek,
                NewSchedule.StartTime,
                NewSchedule.EndTime,
                null,
                null,
                NewSchedule.SlotMinutes,
                NewSchedule.EffectiveFrom,
                null);
            var created = await Api.PostAsync<ScheduleRequest, DoctorScheduleDto>("api/admin/doctor-schedules", request);
            Schedules.Add(created);
            NewSchedule = new ScheduleFormModel();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSavingSchedule = false;
        }
    }

    private async Task CreateTimeOffAsync()
    {
        if (SelectedDoctor is null)
            return;
        IsSavingTimeOff = true;
        try
        {
            var request = new CreateTimeOffRequest(
                SelectedDoctor.Id,
                NewTimeOff.StartAt,
                NewTimeOff.EndAt,
                Vitalis.Domain.Enums.TimeOffType.Leave,
                string.IsNullOrWhiteSpace(NewTimeOff.Reason) ? null : NewTimeOff.Reason);
            var result = await Api.PostAsync<CreateTimeOffRequest, CreateTimeOffResult>("api/admin/time-off", request);
            TimeOffs.Add(result.TimeOff);
            LastConflicts = result.ConflictingAppointments;
            NewTimeOff = new TimeOffFormModel();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSavingTimeOff = false;
        }
    }

    private static string DayName(byte dayOfWeek) => dayOfWeek switch
    {
        0 => "Chủ nhật",
        1 => "Thứ 2",
        2 => "Thứ 3",
        3 => "Thứ 4",
        4 => "Thứ 5",
        5 => "Thứ 6",
        6 => "Thứ 7",
        _ => dayOfWeek.ToString(),
    };

    private class DoctorFormModel
    {
        public string FullName { get; set; } = "";
        public string Title { get; set; } = "";
        public int SpecialtyId { get; set; }
        public string LicenseNumber { get; set; } = "";
        public string Room { get; set; } = "";
        public decimal ConsultationFee { get; set; }
        public int? MaxPatientsPerDay { get; set; }
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private class ScheduleFormModel
    {
        public byte DayOfWeek { get; set; }
        public TimeOnly StartTime { get; set; } = new(8, 0);
        public TimeOnly EndTime { get; set; } = new(17, 0);
        public int SlotMinutes { get; set; } = 30;
        public DateOnly EffectiveFrom { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
    }

    private class TimeOffFormModel
    {
        public DateTime StartAt { get; set; } = DateTime.UtcNow;
        public DateTime EndAt { get; set; } = DateTime.UtcNow.AddHours(1);
        public string Reason { get; set; } = "";
    }
}
