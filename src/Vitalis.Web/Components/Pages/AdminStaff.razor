@page "/admin/staff"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject VitalisApiClient Api
@using Vitalis.Application.Common
@using Vitalis.Application.DTOs.Doctors

<PageTitle>Nhân sự &amp; ca trực · Vitalis</PageTitle>

<div class="flex flex-col w-full gap-space-lg">
<!-- 1. Header & Executive Controls Toolbar -->
<section class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-md bg-surface-container-lowest p-space-lg rounded-xl shadow-sm">
<div class="flex flex-col gap-1.5">
<div class="flex flex-wrap items-center gap-2">
<span class="px-2.5 py-0.5 rounded-full bg-primary-container text-on-primary-container font-label-xs text-label-xs tracking-wider font-semibold uppercase flex items-center gap-1.5">
<span class="w-1.5 h-1.5 rounded-full bg-on-primary-container animate-pulse"></span>
          VC-29 • ISO 9001:2015 &amp; BYT Standard
        </span>
<span class="px-2.5 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed-variant font-label-xs text-label-xs font-semibold">
          Hệ thống Phân ca &amp; Giám sát CCHN Tự Động
        </span>
<span class="text-on-surface-variant font-label-xs text-label-xs flex items-center gap-1">
<span class="material-symbols-outlined text-[15px]">schedule</span>
          Cập nhật: 24/10/2026 08:30:14
        </span>
</div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
        Quản Lý Nhân Sự Y Tế &amp; Điều Phối Ca Trực Toàn Viện
      </h1>
<p class="font-body-sm text-body-sm text-on-surface-variant">
        Phân hệ điều hành Ban Giám Đốc • Giám sát an toàn kíp trực, định mức giờ làm và thẩm quyền chứng chỉ hành nghề.
      </p>
</div>
<!-- Executive Action Suite -->
<div class="flex flex-wrap items-center gap-2 w-full lg:w-auto">
<button class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm transition-all shadow-sm" type="button">
<span class="material-symbols-outlined text-[18px]">download</span>
        Xuất Bảng Trực (Excel/PDF)
      </button>
<button class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm transition-all shadow-sm" type="button">
<span class="material-symbols-outlined text-[18px]">tune</span>
        Cấu Hình Định Mức
      </button>
<button class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-secondary-container hover:bg-secondary text-on-secondary-container font-label-sm text-label-sm transition-all shadow-sm" type="button">
<span class="material-symbols-outlined text-[18px]">auto_awesome</span>
        Xếp Ca Tự Động (AI)
      </button>
<button class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary hover:bg-primary/90 font-label-md text-label-md font-semibold transition-all shadow-sm" type="button" @onclick="OpenCreateDoctorForm">
<span class="material-symbols-outlined text-[18px]">person_add</span>
        + Thêm Bác Sĩ
      </button>
</div>
</section>
@if (ErrorMessage is not null)
{
<div class="flex items-start gap-3 p-3.5 rounded-xl bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-xl shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@ErrorMessage</p>
<button class="text-on-error-container hover:opacity-75" @onclick="() => ErrorMessage = null" type="button">
<span class="material-symbols-outlined text-base">close</span>
</button>
</div>
}
<!-- Filter & Time Segment Selection Ribbon -->
<section class="grid grid-cols-1 md:grid-cols-12 gap-space-sm bg-surface-container-low p-space-sm rounded-xl">
<div class="md:col-span-4 flex items-center gap-2 bg-surface-container-lowest px-3 py-1.5 rounded-xl shadow-sm">
<span class="material-symbols-outlined text-primary text-[20px]">calendar_month</span>
<div class="flex flex-col">
<span class="font-label-xs text-label-xs text-on-surface-variant font-medium">Khoảng thời gian</span>
<span class="font-label-md text-label-md text-on-surface font-semibold">Tuần 43 (20/10/2026 - 26/10/2026)</span>
</div>
<span class="ml-auto text-on-surface-variant material-symbols-outlined text-[18px]">expand_more</span>
</div>
<div class="md:col-span-4 flex items-center gap-2 bg-surface-container-lowest px-3 py-1.5 rounded-xl shadow-sm">
<span class="material-symbols-outlined text-secondary text-[20px]">apartment</span>
<div class="flex flex-col">
<span class="font-label-xs text-label-xs text-on-surface-variant font-medium">Khoa / Phòng</span>
<span class="font-label-md text-label-md text-on-surface font-semibold">Toàn Viện (Tất cả 12 đơn vị)</span>
</div>
<span class="ml-auto text-on-surface-variant material-symbols-outlined text-[18px]">expand_more</span>
</div>
<div class="md:col-span-4 flex items-center gap-2 bg-surface-container-lowest px-3 py-1.5 rounded-xl shadow-sm">
<span class="material-symbols-outlined text-tertiary text-[20px]">badge</span>
<div class="flex flex-col">
<span class="font-label-xs text-label-xs text-on-surface-variant font-medium">Khối chức danh</span>
<span class="font-label-md text-label-md text-on-surface font-semibold">Tất cả (BS, Điều dưỡng, KTV, DS)</span>
</div>
<span class="ml-auto text-on-surface-variant material-symbols-outlined text-[18px]">expand_more</span>
</div>
</section>
<!-- 2. Top 4 KPIs Scorecards -->
<section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
<!-- Card 1 -->
<div class="flex flex-col justify-between p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">Tổng Quân Số Đi Làm</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-on-surface font-bold">68</span>
<span class="font-headline-sm text-headline-sm text-on-surface-variant">/ 74</span>
</div>
</div>
<div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[24px]">group</span>
</div>
</div>
<div class="mt-4 pt-3 flex flex-col gap-2 bg-surface-container-low -mx-space-md -mb-space-md p-space-md rounded-b-xl">
<div class="flex items-center justify-between font-label-xs text-label-xs">
<span class="text-on-surface-variant">4 nghỉ phép năm • 2 đào tạo CME</span>
<span class="px-2 py-0.5 rounded-full bg-primary text-on-primary font-bold">91.9%</span>
</div>
<div class="w-full bg-surface-dim h-1.5 rounded-full overflow-hidden">
<div class="bg-primary h-full rounded-full" style="width: 91.9%"></div>
</div>
</div>
</div>
<!-- Card 2 -->
<div class="flex flex-col justify-between p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">Kíp Trực Đêm Nay (24/10)</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-primary font-bold">12</span>
<span class="font-label-md text-label-md text-on-surface-variant font-medium">nhân sự chốt</span>
</div>
</div>
<div class="w-10 h-10 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary">
<span class="material-symbols-outlined text-[24px]">bedtime</span>
</div>
</div>
<div class="mt-4 pt-3 flex flex-col gap-1 bg-surface-container-low -mx-space-md -mb-space-md p-space-md rounded-b-xl">
<div class="flex items-center justify-between font-label-xs text-label-xs">
<span class="text-on-surface font-semibold">Trưởng kíp: BS.CKII Nguyễn Văn Linh</span>
<span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-bold">PASS 100%</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant">4 BS Chuyên khoa • 6 ĐD Cấp cứu • 2 KTV</span>
</div>
</div>
<!-- Card 3 -->
<div class="flex flex-col justify-between p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">Định Mức &amp; Tải Giờ Làm</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-on-surface font-bold">94.6%</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">an toàn</span>
</div>
</div>
<div class="w-10 h-10 rounded-xl bg-tertiary-fixed flex items-center justify-center text-tertiary">
<span class="material-symbols-outlined text-[24px]">health_and_safety</span>
</div>
</div>
<div class="mt-4 pt-3 flex flex-col gap-1 bg-surface-container-low -mx-space-md -mb-space-md p-space-md rounded-b-xl">
<div class="flex items-center justify-between font-label-xs text-label-xs">
<span class="text-error font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[15px]">warning</span>
            02 BS vượt ngưỡng &gt;48h/tuần
          </span>
<span class="text-on-surface-variant">Burnout Risk</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant">Đã gửi thông báo cân đối ca trực bù nghỉ</span>
</div>
</div>
<!-- Card 4 -->
<div class="flex flex-col justify-between p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">Chứng Chỉ Hành Nghề (CCHN)</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-on-surface font-bold">100%</span>
<span class="font-label-sm text-label-sm text-primary font-semibold">Hợp lệ</span>
</div>
</div>
<div class="w-10 h-10 rounded-xl bg-primary-fixed-dim flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[24px]">verified_user</span>
</div>
</div>
<div class="mt-4 pt-3 flex flex-col gap-1 bg-surface-container-low -mx-space-md -mb-space-md p-space-md rounded-b-xl">
<div class="flex items-center justify-between font-label-xs text-label-xs">
<span class="text-on-surface font-medium">03 chứng chỉ an toàn sắp hạn &lt;45 ngày</span>
<span class="px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-bold">GCP / CME</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant">Đã đăng ký lớp bồi dưỡng Sở Y Tế T11/2026</span>
</div>
</div>
</section>
<!-- 3. Active Incident Response & Safety Alert Banner -->
<section class="grid grid-cols-1 lg:grid-cols-12 gap-space-md">
<!-- Live Shortage Alert & AI Recommendation -->
<div class="lg:col-span-8 p-space-md rounded-xl bg-error-container text-on-error-container flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md shadow-sm">
<div class="flex items-start gap-3">
<div class="p-2 rounded-xl bg-error text-on-error mt-0.5">
<span class="material-symbols-outlined text-[22px]">notification_important</span>
</div>
<div class="flex flex-col gap-1">
<div class="flex items-center gap-2">
<span class="font-title-md text-title-md font-bold">Cảnh báo: Khoa Cấp Cứu thiếu 01 Điều dưỡng ca chiều (14:00 - 22:00)</span>
<span class="px-2 py-0.5 rounded-full bg-error text-on-error font-label-xs text-label-xs font-bold uppercase">Cấp thiết</span>
</div>
<p class="font-body-sm text-body-sm">
            ĐD. Lê Thị Hòa xin nghỉ ốm đột xuất. <strong>AI Vitalis Đề Xuất:</strong> Tăng cường <strong>ĐD. Trần Thu Thủy</strong> từ Ngoại trú sang (công suất phòng khám chiều nay đạt 32%, đáp ứng tiêu chuẩn thay thế an toàn).
          </p>
</div>
</div>
<div class="flex items-center gap-2 w-full sm:w-auto shrink-0">
<button class="w-full sm:w-auto px-4 py-2 rounded-xl bg-error text-on-error hover:bg-error/90 font-label-md text-label-md font-semibold transition-all" type="button">
          Xác Nhận Điều Chuyển
        </button>
</div>
</div>
<!-- Ready On-Call Cardiac Interventional Alert -->
<div class="lg:col-span-4 p-space-md rounded-xl bg-primary text-on-primary flex items-center justify-between gap-space-md shadow-sm">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-xl bg-on-primary/15 flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-primary-fixed text-[24px]">cardiology</span>
</div>
<div class="flex flex-col">
<div class="font-label-xs text-label-xs text-on-primary-container tracking-wider uppercase font-semibold">Tình Trạng Sẵn Sàng 24/7</div>
<div class="font-title-md text-title-md font-bold leading-tight mt-0.5">Kíp Tim Mạch &amp; Can Thiệp Cấp Cứu</div>
<div class="font-body-sm text-body-sm text-on-primary/80 mt-0.5">BS.CKII Nguyễn Văn Linh + Ekip Gây mê</div>
</div>
</div>
<span class="w-3 h-3 rounded-full bg-primary-fixed animate-ping shrink-0 mr-1"></span>
</div>
</section>
<!-- 4. Doctor management (real data: GET/POST/PUT/PATCH /api/doctors, /api/admin/doctors) -->
<section class="flex flex-col bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
<div class="p-space-md flex flex-col md:flex-row items-start md:items-center justify-between gap-space-sm bg-surface-container-low">
<div class="flex items-center gap-3">
<div class="p-2 rounded-xl bg-primary text-on-primary">
<span class="material-symbols-outlined text-[20px]">stethoscope</span>
</div>
<div>
<h2 class="font-title-md text-title-md text-on-surface font-bold">Danh Sách Bác Sĩ</h2>
<p class="font-body-sm text-body-sm text-on-surface-variant">Quản lý hồ sơ, lịch làm việc theo tuần và ngày nghỉ của từng bác sĩ</p>
</div>
</div>
<input class="h-10 px-3 w-64 bg-surface-container-lowest text-on-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Tìm bác sĩ theo tên..." @bind="DoctorKeyword" @bind:event="oninput"/>
</div>
@if (ShowCreateDoctorForm)
{
<form class="p-space-md grid grid-cols-1 md:grid-cols-3 gap-3 bg-surface-container-low/50 border-t-0" @onsubmit="CreateDoctorAsync" @onsubmit:preventDefault="true">
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Họ tên <span class="text-error">*</span></label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required @bind="NewDoctor.FullName"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Học hàm/Học vị</label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" @bind="NewDoctor.Title"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Chuyên khoa <span class="text-error">*</span></label>
<select class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none" required @bind="NewDoctor.SpecialtyId">
<option value="0">-- Chọn chuyên khoa --</option>
@foreach (var specialty in Specialties)
{
<option value="@specialty.Id">@specialty.Name</option>
}
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Số CCHN</label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" @bind="NewDoctor.LicenseNumber"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Phòng khám</label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" @bind="NewDoctor.Room"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Phí khám (VND) <span class="text-error">*</span></label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required type="number" @bind="NewDoctor.ConsultationFee"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Tối đa BN/ngày</label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" type="number" @bind="NewDoctor.MaxPatientsPerDay"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Tên đăng nhập <span class="text-error">*</span></label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required @bind="NewDoctor.Username"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-sm text-label-sm text-on-surface">Mật khẩu <span class="text-error">*</span></label>
<input class="h-10 px-3 bg-surface-container-lowest rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" required type="password" @bind="NewDoctor.Password"/>
</div>
<div class="md:col-span-3 flex items-center justify-end gap-3">
<button class="px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-title-md text-title-md transition-colors" type="button" @onclick="() => ShowCreateDoctorForm = false">Huỷ</button>
<button class="px-5 py-2.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md font-semibold transition-colors shadow-sm disabled:opacity-60" disabled="@IsSaving" type="submit">@(IsSaving ? "Đang lưu..." : "Tạo bác sĩ")</button>
</div>
</form>
}
<div class="overflow-x-auto w-full">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container text-on-surface font-label-sm text-label-sm">
<th class="p-3">Bác Sĩ</th>
<th class="p-3">Chuyên Khoa</th>
<th class="p-3">Phòng</th>
<th class="p-3 text-right">Phí Khám</th>
<th class="p-3 text-center">Trạng Thái</th>
<th class="p-3 text-right">Thao Tác</th>
</tr>
</thead>
<tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
@if (IsLoadingDoctors)
{
<tr><td class="p-3 text-on-surface-variant" colspan="6">Đang tải...</td></tr>
}
else if (FilteredDoctors.Count == 0)
{
<tr><td class="p-3 text-on-surface-variant" colspan="6">Không tìm thấy bác sĩ nào.</td></tr>
}
else
{
@foreach (var doctor in FilteredDoctors)
{
<tr class="hover:bg-surface-container-low transition-colors @(SelectedDoctor?.Id == doctor.Id ? "bg-primary-fixed/10" : "")">
<td class="p-3">
<div class="flex flex-col">
<span class="font-title-md text-title-md text-on-surface font-semibold">@(doctor.Title is null ? "" : doctor.Title + " ")@doctor.FullName</span>
<span class="font-label-xs text-label-xs text-on-surface-variant">@doctor.Username @(doctor.LicenseNumber is null ? "" : $"• CCHN {doctor.LicenseNumber}")</span>
</div>
</td>
<td class="p-3 text-on-surface-variant">@doctor.SpecialtyName</td>
<td class="p-3 text-on-surface-variant">@(doctor.Room ?? "-")</td>
<td class="p-3 text-right font-mono">@(doctor.ConsultationFee?.ToString("N0") ?? "-")</td>
<td class="p-3 text-center">
@if (doctor.IsActive)
{
<span class="inline-flex items-center px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed-variant font-label-xs text-label-xs font-semibold">Đang làm việc</span>
}
else
{
<span class="inline-flex items-center px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-xs text-label-xs font-semibold">Ngừng</span>
}
</td>
<td class="p-3 text-right">
<div class="flex items-center justify-end gap-1">
<button class="px-2.5 py-1 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-xs text-label-xs font-semibold" type="button" @onclick="() => SelectDoctorAsync(doctor)">Lịch &amp; Nghỉ phép</button>
@if (doctor.IsActive)
{
<button class="p-1.5 rounded-lg text-outline hover:text-error hover:bg-surface-container transition-colors" title="Ngừng công tác" type="button" @onclick="() => DeactivateDoctorAsync(doctor.Id)">
<span class="material-symbols-outlined text-[18px]">block</span>
</button>
}
</div>
</td>
</tr>
}
}
</tbody>
</table>
</div>
@if (SelectedDoctor is not null)
{
<div class="p-space-md border-t-0 bg-surface-container-low/40 grid grid-cols-1 lg:grid-cols-2 gap-space-md">
<!-- Weekly schedule -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-3">
<h3 class="font-title-md text-title-md text-on-surface font-bold">Lịch Làm Việc Theo Tuần · @SelectedDoctor.FullName</h3>
<form class="grid grid-cols-2 md:grid-cols-3 gap-2 items-end" @onsubmit="CreateScheduleAsync" @onsubmit:preventDefault="true">
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Thứ (0=CN)</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" max="6" min="0" required type="number" @bind="NewSchedule.DayOfWeek"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Bắt đầu</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" required type="time" @bind="NewSchedule.StartTime"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Kết thúc</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" required type="time" @bind="NewSchedule.EndTime"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Phút/slot</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" required type="number" @bind="NewSchedule.SlotMinutes"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Hiệu lực từ</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" required type="date" @bind="NewSchedule.EffectiveFrom"/>
</div>
<button class="h-9 px-3 rounded-lg bg-primary-container text-on-primary font-label-sm text-label-sm font-semibold disabled:opacity-60" disabled="@IsSavingSchedule" type="submit">@(IsSavingSchedule ? "..." : "Thêm slot")</button>
</form>
<div class="flex flex-col gap-1.5 mt-1">
@if (Schedules.Count == 0)
{
<span class="font-label-xs text-label-xs text-on-surface-variant">Chưa có lịch làm việc nào.</span>
}
@foreach (var schedule in Schedules)
{
<div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low font-label-sm text-label-sm">
<span>@DayName(schedule.DayOfWeek): @schedule.StartTime - @schedule.EndTime (mỗi @schedule.SlotMinutes phút)</span>
<span class="font-label-xs text-label-xs @(schedule.IsActive ? "text-primary" : "text-on-surface-variant")">@(schedule.IsActive ? "Đang áp dụng" : "Ngừng")</span>
</div>
}
</div>
</div>
<!-- Time off -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-3">
<h3 class="font-title-md text-title-md text-on-surface font-bold">Ngày Nghỉ · @SelectedDoctor.FullName</h3>
<form class="grid grid-cols-2 gap-2 items-end" @onsubmit="CreateTimeOffAsync" @onsubmit:preventDefault="true">
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Từ</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" required type="datetime-local" @bind="NewTimeOff.StartAt"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant">Đến</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" required type="datetime-local" @bind="NewTimeOff.EndAt"/>
</div>
<div class="flex flex-col gap-1 col-span-2">
<label class="font-label-xs text-label-xs text-on-surface-variant">Lý do</label>
<input class="h-9 px-2 bg-surface-container-low rounded-lg" @bind="NewTimeOff.Reason"/>
</div>
<button class="h-9 px-3 rounded-lg bg-primary-container text-on-primary font-label-sm text-label-sm font-semibold disabled:opacity-60 col-span-2" disabled="@IsSavingTimeOff" type="submit">@(IsSavingTimeOff ? "..." : "Đăng ký nghỉ")</button>
</form>
@if (LastConflicts is { Count: > 0 })
{
<div class="p-2.5 rounded-lg bg-error-container text-on-error-container font-label-xs text-label-xs">
                  @LastConflicts.Count lịch hẹn cần được lễ tân sắp xếp lại trong khoảng thời gian nghỉ này.
                </div>
}
<div class="flex flex-col gap-1.5 mt-1">
@if (TimeOffs.Count == 0)
{
<span class="font-label-xs text-label-xs text-on-surface-variant">Chưa có ngày nghỉ nào.</span>
}
@foreach (var timeOff in TimeOffs)
{
<div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low font-label-sm text-label-sm">
<span>@timeOff.StartAt.ToString("dd/MM/yyyy HH:mm") - @timeOff.EndAt.ToString("dd/MM/yyyy HH:mm") (@timeOff.Type)</span>
</div>
}
</div>
</div>
</div>
}
</section>
