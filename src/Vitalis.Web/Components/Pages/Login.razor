<!-- Interactive "Quên mật khẩu" Modal Dialog Backdrop -->
<div class="fixed inset-0 z-50 hidden bg-inverse-surface/40 backdrop-blur-sm flex items-center justify-center p-4" id="forgot-modal">
<div class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-xl p-6 sm:p-8 flex flex-col gap-4">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2.5">
<div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-xl">restart_alt</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Đặt lại mật khẩu</h3>
</div>
<button class="text-outline hover:text-on-surface transition-colors p-1" onclick="closeForgotPasswordModal()" type="button">
<span class="material-symbols-outlined text-xl">close</span>
</button>
</div>
<p class="font-body-md text-body-md text-on-surface-variant text-left leading-relaxed">
        Nhập địa chỉ email đăng ký trên hệ thống Vitalis. Chúng tôi sẽ gửi hướng dẫn khôi phục tài khoản trong ít phút.
      </p>
<form class="flex flex-col gap-4 mt-1" @onsubmit="HandleForgotPasswordAsync" @onsubmit:preventDefault="true">
<div class="flex flex-col gap-1.5 text-left">
<label class="font-label-md text-label-md text-on-surface" for="reset-email">
            Email xác thực <span class="text-error font-bold">*</span>
</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-outline text-lg pointer-events-none">mail</span>
<input class="w-full h-11 pl-10 pr-3 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:bg-surface-container-lowest transition-all duration-150 outline-none shadow-sm" id="reset-email" placeholder="ten.nguoidung@@vitalis.vn" required="" type="email" @bind="ResetEmail"/>
</div>
</div>
@if (ResetLinkSent)
{
<div class="p-3 rounded-lg bg-surface-container text-primary font-body-sm text-body-sm flex items-center gap-2">
<span class="material-symbols-outlined text-base">check_circle</span>
<span>Liên kết đã được gửi! Vui lòng kiểm tra hòm thư đến hoặc thư rác.</span>
</div>
}
<div class="flex items-center justify-end gap-3 mt-3">
<button class="px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-title-md text-title-md transition-colors" onclick="closeForgotPasswordModal()" type="button">
            Huỷ bỏ
          </button>
<button class="px-5 py-2.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md font-semibold transition-colors shadow-sm" disabled="@IsResetBusy" type="submit">
            @(ResetLinkSent ? "Đã gửi" : "Gửi liên kết đặt lại")
          </button>
</div>
</form>
</div>
</div>
</div>

<script src="js/pages/Login.js"></script>

@code {
    private string Username { get; set; } = "";
    private string Password { get; set; } = "";
    private string? ErrorMessage { get; set; }
    private bool IsBusy { get; set; }

    private string ResetEmail { get; set; } = "";
    private bool IsResetBusy { get; set; }
    private bool ResetLinkSent { get; set; }

    // Quick-fill demo accounts (VC-01) — matches DbSeeder's seeded accounts per role.
    private void SetRole(string role)
    {
        (Username, Password) = role switch
        {
            "admin" => ("admin", "Admin@123"),
            "doctor" => ("doctor", "Doctor@123"),
            "receptionist" => ("reception", "Reception@123"),
            "pharmacist" => ("pharmacist", "Pharmacist@123"),
            "patient" => ("patient", "Patient@123"),
            _ => (Username, Password),
        };
        ErrorMessage = null;
    }

    private async Task HandleLoginAsync()
    {
        ErrorMessage = null;
        IsBusy = true;
        try
        {
            var response = await Api.LoginAsync(new LoginRequest { Username = Username, Password = Password });
            TokenStore.SetSession(response.AccessToken, response.RefreshToken, response.User);
            Navigation.NavigateTo(LandingPageFor(response.User.Roles));
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task HandleForgotPasswordAsync()
    {
        IsResetBusy = true;
        try
        {
            await Api.ForgotPasswordAsync(new ForgotPasswordRequest { Email = ResetEmail });
            ResetLinkSent = true;
        }
        finally
        {
            IsResetBusy = false;
        }
    }

    private static string LandingPageFor(IReadOnlyList<string> roles) => roles switch
    {
        _ when roles.Contains("Admin") => "/admin/reports",
        _ when roles.Contains("Doctor") => "/doctor/queue",
        _ when roles.Contains("Receptionist") => "/reception",
        _ when roles.Contains("Pharmacist") => "/pharmacy/inventory",
        _ => "/my-appointments",
    };
}
