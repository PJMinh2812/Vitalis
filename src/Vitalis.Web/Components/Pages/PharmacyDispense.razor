@page "/pharmacy/dispense"
@layout PharmacyLayout
@attribute [Authorize(Roles = "Pharmacist")]
@using Vitalis.Application.DTOs.MedicalRecords
@using Vitalis.Application.DTOs.Pharmacy
@using Vitalis.Domain.Enums
@inject VitalisApiClient Api

<PageTitle>Phát thuốc · Vitalis</PageTitle>

<div class="flex flex-col w-full">
<!-- Interactive script for active dispense desk -->

<div class="p-space-lg space-y-space-md max-w-[1600px] mx-auto w-full">
@if (LoadError is not null)
{
<div class="flex items-start gap-3 p-3.5 rounded-xl bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-xl shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@LoadError</p>
<button class="text-on-error-container hover:opacity-75" @onclick="() => LoadError = null" type="button">
<span class="material-symbols-outlined text-base">close</span>
</button>
</div>
}
@if (DispenseError is not null)
{
<div class="flex items-start gap-3 p-3.5 rounded-xl bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-xl shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@DispenseError</p>
<button class="text-on-error-container hover:opacity-75" @onclick="() => DispenseError = null" type="button">
<span class="material-symbols-outlined text-base">close</span>
</button>
</div>
}
@if (DispenseResult is not null)
{
<div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#DCFCE7] text-[#166534] shadow-sm">
<span class="material-symbols-outlined text-[#166534] text-xl shrink-0 mt-0.5">check_circle</span>
<p class="flex-1 font-body-sm text-body-sm">Cấp phát thành công đơn thuốc #@DispenseResult.PrescriptionId lúc @(DispenseResult.DispensedAt?.ToLocalTime().ToString("HH:mm dd/MM/yyyy")).</p>
</div>
}
<!-- Breadcrumb & Module Navigation Meta -->
<div class="flex flex-wrap items-center justify-between gap-space-sm pb-space-xs">
<div class="flex items-center gap-2">
<span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-primary text-on-primary">
<span class="material-symbols-outlined text-[18px]">prescriptions</span>
</span>
<div class="flex items-center gap-1.5 font-body-sm text-body-sm text-on-surface-variant">
<span class="font-title-md text-title-md text-on-surface font-bold tracking-tight">Cấp Phát Thuốc Ngoại Trú</span>
<span class="text-outline-variant">/</span>
<span class="font-label-sm text-label-sm text-primary font-semibold">VC-17 Dispense Station</span>
</div>
<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-xs text-label-xs font-semibold">
<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span> Quầy 01 - Hoạt động
        </span>
</div>
<div class="flex items-center gap-space-xs">
<span class="font-label-xs text-label-xs text-on-surface-variant">Hệ thống dược trực tuyến:</span>
<span class="inline-flex items-center gap-1 text-primary font-label-xs text-label-xs font-semibold">
<span class="material-symbols-outlined text-[14px]">wifi</span> HIS • VITALIS Connected
        </span>
<span class="text-outline-variant mx-1">|</span>
<span class="font-label-xs text-label-xs text-on-surface-variant">Phiên làm việc:</span>
<span class="font-label-xs text-label-xs text-on-surface font-semibold">DS. Lê Hoàng Nam</span>
</div>
</div>
<!-- 1. Top KPI Summary Cards (4 Bento Stats) -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
<!-- Card 1: Chờ cấp phát -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
<div class="flex items-start justify-between">
<div>
<span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant font-bold">Chờ cấp phát hôm nay</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-on-surface font-bold">18</span>
<span class="font-label-sm text-label-sm text-primary font-semibold">đơn thuốc</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[22px]">pending_actions</span>
</div>
</div>
<div class="flex flex-wrap gap-1.5 mt-space-sm pt-space-xs border-none">
<span class="px-2 py-0.5 rounded-full bg-surface-container-high text-primary font-label-xs text-[11px] font-semibold">4 BHYT ưu tiên</span>
<span class="px-2 py-0.5 rounded-full bg-surface-container-low text-tertiary font-label-xs text-[11px] font-medium">2 đã thanh toán chờ lấy</span>
</div>
</div>
<!-- Card 2: Hoàn thành cấp phát -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
<div class="flex items-start justify-between">
<div>
<span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant font-bold">Đã hoàn thành cấp phát</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-primary font-bold">76</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">/ 94 dự kiến</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">task_alt</span>
</div>
</div>
<div class="flex items-center justify-between text-on-surface-variant font-label-xs text-label-xs mt-space-sm pt-space-xs">
<span>Sản lượng: <strong class="text-on-surface">342</strong> hộp • vỉ</span>
<span class="text-primary font-semibold">80.8% tiến độ</span>
</div>
</div>
<!-- Card 3: Thời gian soạn TB -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
<div class="flex items-start justify-between">
<div>
<span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant font-bold">Thời gian soạn &amp; kiểm soát</span>
<div class="flex items-baseline gap-1 mt-1">
<span class="font-display text-display text-on-surface font-bold">3.8</span>
<span class="font-title-md text-title-md text-on-surface-variant">phút/đơn</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-tertiary">
<span class="material-symbols-outlined text-[22px]">timer</span>
</div>
</div>
<div class="flex items-center gap-1.5 mt-space-sm pt-space-xs">
<span class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-surface-container-high text-primary font-label-xs text-[11px] font-semibold">
<span class="material-symbols-outlined text-[12px] mr-0.5">trending_down</span> Chuẩn &lt; 5.0p
          </span>
<span class="text-on-surface-variant font-label-xs text-[11px]">Nhanh hơn 1.2p so với ca qua</span>
</div>
</div>
<!-- Card 4: Cảnh báo Dược lâm sàng -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm relative overflow-hidden flex flex-col justify-between">
<div class="flex items-start justify-between">
<div>
<span class="font-label-xs text-label-xs uppercase tracking-wider text-error font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-[15px]">verified_user</span> Dược lâm sàng trong ngày
            </span>
<div class="flex items-baseline gap-2 mt-1">
<span class="font-display text-display text-error font-bold">03</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">can thiệp</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-error-container text-on-error-container flex items-center justify-center">
<span class="material-symbols-outlined text-[22px]">warning</span>
</div>
</div>
<div class="text-on-surface-variant font-label-xs text-[11px] mt-space-sm pt-space-xs leading-relaxed truncate">
          2 tương tác nhẹ • 1 đề xuất đổi liều đã BS xác nhận
        </div>
</div>
</section>
<!-- 2. Action Header & Barcode Scanner Bar -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col xl:flex-row items-stretch xl:items-center justify-between gap-space-md">
<div class="flex items-center gap-space-sm">
<div class="w-12 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[28px]">qr_code_scanner</span>
</div>
<div>
<div class="flex items-center gap-2">
<h2 class="font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight">Quầy Cấp Phát Thuốc Ngoại Trú (Counter 01)</h2>
<span class="px-2 py-0.5 rounded-full bg-surface-container text-primary font-label-xs text-label-xs font-semibold">Sẵn sàng quét mã</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">Đang mở phiên đối soát tự động qua mã vạch DataMatrix &amp; CCCD gắn chip</p>
</div>
</div>
<!-- Barcode / QR Scanner Input + Fast Hotkeys -->
<div class="flex-1 max-w-2xl flex flex-col md:flex-row items-center gap-space-xs">
<form class="relative w-full" @onsubmit="LookupAsync" @onsubmit:preventDefault="true">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-primary text-[20px]">barcode_scanner</span>
<input class="w-full h-11 pl-10 pr-24 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant outline-none focus:bg-surface-container-lowest transition-all" placeholder="Nhập mã bệnh án (Medical Record ID)..." type="number" @bind="MedicalRecordIdInput"/>
<button class="absolute right-1.5 top-1.5 bottom-1.5 px-3 rounded-lg bg-primary text-on-primary font-label-xs text-label-xs font-semibold flex items-center gap-1 hover:bg-tertiary-container transition-colors disabled:opacity-60" disabled="@IsLoading" type="submit">
<span class="material-symbols-outlined text-[16px]">search</span> @(IsLoading ? "Đang tra..." : "Tra cứu")
          </button>
</form>
<button class="w-full md:w-auto h-11 px-4 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold flex items-center justify-center gap-2 whitespace-nowrap transition-colors" type="button">
<span class="material-symbols-outlined text-primary text-[18px]">volume_up</span>
<span>Gọi số nhận thuốc (F2)</span>
</button>
</div>
</div>
<!-- Filter chips for Prescriptions queue -->
<div class="flex items-center justify-between overflow-x-auto pb-1 gap-2">
<div class="flex items-center gap-1.5">
<button class="px-3.5 py-1.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-semibold flex items-center gap-1 shadow-sm">
<span>Tất cả đơn</span>
<span class="px-1.5 py-0.2 rounded-full bg-surface-container-lowest/20 text-on-primary text-[10px]">18</span>
</button>
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-lowest hover:bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-medium flex items-center gap-1 transition-colors">
<span>BHYT ngoại trú</span>
<span class="px-1.5 py-0.2 rounded-full bg-surface-container-high text-primary text-[10px]">11</span>
</button>
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-lowest hover:bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-medium flex items-center gap-1 transition-colors">
<span>Thu phí / Dịch vụ</span>
<span class="px-1.5 py-0.2 rounded-full bg-surface-container text-on-surface text-[10px]">5</span>
</button>
<button class="px-3.5 py-1.5 rounded-full bg-surface-container-lowest hover:bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-medium flex items-center gap-1 transition-colors">
<span>Ưu tiên • Hẹn giờ</span>
<span class="px-1.5 py-0.2 rounded-full bg-error-container text-on-error-container text-[10px]">2</span>
</button>
</div>
<div class="flex items-center gap-space-xs text-on-surface-variant font-label-xs text-label-xs shrink-0">
<span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-primary"></span> Khớp mã barcode</span>
<span class="flex items-center gap-1 ml-2"><span class="w-2 h-2 rounded-full bg-surface-variant"></span> Chưa đối chiếu</span>
</div>
</div>
<!-- 3. Two-Column Workspace Layout (65% Left / 35% Right) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md items-start">
<!-- ================= LEFT COLUMN: CHI TIẾT ĐƠN SOẠN PHÁT (8/12 cols) ================= -->
<div class="lg:col-span-8 space-y-space-md">
<!-- Patient & Prescription Banner (High Polish Master Card) -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-md">
<div class="flex flex-wrap items-start justify-between gap-space-sm">
<div class="flex items-center gap-space-sm">
<div class="w-14 h-14 rounded-xl bg-surface-container-low flex items-center justify-center text-primary font-display text-[22px] font-bold">
                @(Record is null ? "--" : new string(Record.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).ToArray()).ToUpperInvariant())
              </div>
<div>
<div class="flex items-center gap-2">
<h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">@(Record?.PatientName ?? "Chưa tra cứu bệnh án")</h3>
@if (Record is not null)
{
<span class="font-label-xs text-label-xs text-on-surface-variant font-mono">Mã BN: @Record.PatientId</span>
}
</div>
<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-on-surface-variant font-body-sm text-body-sm mt-0.5">
@if (Record?.Prescription is not null)
{
<span class="text-primary font-semibold font-mono">Đơn thuốc #@Record.Prescription.Id</span>
<span>•</span>
}
<span>Bác sĩ điều trị: <strong class="text-on-surface">@(Record?.DoctorName ?? "—")</strong></span>
</div>
</div>
</div>
<div class="flex flex-col items-end gap-1">
@if (Record?.Prescription is not null)
{
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm @(IsDispensed ? "bg-primary text-on-primary" : "bg-surface-container-high text-primary")">
<span class="material-symbols-outlined text-[16px]">@(IsDispensed ? "task_alt" : "pending_actions")</span>
                @(IsDispensed ? "Đã cấp phát" : "Chờ cấp phát")
              </span>
}
</div>
</div>
<!-- Doctor & Diagnostic Note Bar -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-sm p-space-sm rounded-lg bg-surface-container-low">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">stethoscope</span>
<div class="text-left font-body-sm text-body-sm">
<span class="text-on-surface-variant">Bác sĩ kê:</span>
<span class="font-semibold text-on-surface ml-1">@(Record?.DoctorName ?? "—")</span>
</div>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-tertiary text-[20px]">assignment</span>
<div class="font-body-sm text-body-sm text-on-surface truncate">
<span class="text-on-surface-variant">Chẩn đoán:</span>
<span class="font-medium ml-1">@(Record?.Diagnosis ?? "—")@(string.IsNullOrWhiteSpace(Record?.Icd10Code) ? "" : $" ({Record!.Icd10Code})")</span>
</div>
</div>
</div>
<!-- CẢNH BÁO DỊ ỨNG NỔI BẬT (CRITICAL MEDICAL ALERT) -->
<div class="p-space-sm rounded-xl bg-error-container/40 flex items-start gap-3">
<div class="w-8 h-8 rounded-lg bg-error text-on-error flex items-center justify-center shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">warning</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between mb-1">
<span class="font-label-sm text-label-sm text-error font-bold uppercase tracking-wider">Tiền sử Dị ứng Cần Lưu Ý Khi Cấp Phát:</span>
<span class="font-label-xs text-[10px] text-error font-semibold bg-surface-container-lowest px-2 py-0.5 rounded-full">Hồ sơ xác thực bởi Bác sĩ</span>
</div>
<div class="flex flex-wrap items-center gap-2">
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-error text-on-error font-label-xs text-label-xs font-bold shadow-sm">
<span class="material-symbols-outlined text-[14px]">dangerous</span> DỊ ỨNG PENICILLIN (Tiền sử Sốc phản vệ độ III)
                </span>
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-high text-tertiary font-label-xs text-label-xs font-semibold">
<span class="material-symbols-outlined text-[14px]">info</span> DỊ ỨNG HẢI SẢN (Mẩn ngứa nhẹ)
                </span>
<span class="font-body-sm text-body-sm text-on-surface-variant ml-1">
                  Đơn hiện tại <strong class="text-on-surface">KHÔNG</strong> chứa nhóm Beta-lactam.
                </span>
</div>
</div>
</div>
<!-- Clinical Pharmacy Verification Banner (Vitalis AI Guardian & Dược lâm sàng) -->
<div class="p-space-sm rounded-xl bg-surface-container-low flex items-start gap-3">
<div class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">verified</span>
</div>
<div class="flex-1">
<div class="flex items-center gap-2">
<span class="font-label-sm text-label-sm text-primary font-bold">Vitalis Clinical AI Guardian • Dược lâm sàng đã thẩm duyệt</span>
<span class="px-1.5 py-0.2 rounded bg-surface-container-high text-primary font-label-xs text-[10px] font-semibold">Tự động đối soát</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface mt-0.5 leading-relaxed">
                Đã kiểm tra tương tác thuốc: <strong class="text-primary font-semibold">AN TOÀN</strong>. 
                <span class="text-on-surface-variant">BS đã điều chỉnh thay thế Aspirin bằng</span>
<strong class="text-on-surface">Clopidogrel 75mg</strong>
<span class="text-on-surface-variant">theo khuyến cáo lâm sàng do người bệnh có tiền sử viêm loét dạ dày - tá tràng.</span>
</p>
</div>
</div>
</div>
<!-- BẢNG DANH MỤC THUỐC CẦN SOẠN & PHÁT (Prescription Items Table) -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
<div class="px-space-md py-space-sm bg-surface-container-low flex flex-wrap items-center justify-between gap-space-sm">
<div class="flex items-center gap-2">
<span class="font-title-md text-title-md text-on-surface font-bold">Danh Mục Thuốc Cần Soạn &amp; Phát</span>
<span class="px-2 py-0.5 rounded-full bg-surface-container text-on-surface font-label-xs text-label-xs font-semibold">@(Record?.Prescription?.Items.Count ?? 0) Biệt dược</span>
</div>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-lowest text-on-surface-variant font-label-xs text-label-xs uppercase tracking-wider">
<th class="py-3 px-3 text-center w-10">STT</th>
<th class="py-3 px-4">Tên biệt dược</th>
<th class="py-3 px-3">Liều dùng • Hướng dẫn</th>
<th class="py-3 px-3 text-center">SL Kê</th>
<th class="py-3 px-3">Số lô đã phát</th>
<th class="py-3 px-4 text-center">Trạng thái</th>
</tr>
</thead>
<tbody class="divide-none font-body-sm text-body-sm text-on-surface">
@if (Record?.Prescription is null)
{
<tr><td colspan="6" class="py-6 px-4 text-center text-on-surface-variant">@(Record is null ? "Nhập mã bệnh án để tra cứu đơn thuốc." : "Bệnh án này chưa có đơn thuốc.")</td></tr>
}
else
{
@for (var i = 0; i < Record.Prescription.Items.Count; i++)
{
var item = Record.Prescription.Items[i];
var batchNo = BatchNoFor(item.Id);
<tr class="hover:bg-surface-container-low/70 transition-colors">
<td class="py-3.5 px-3 text-center font-bold text-on-surface-variant">@((i + 1).ToString("00"))</td>
<td class="py-3.5 px-4">
<div class="font-title-md text-title-md text-primary font-bold">@item.MedicineName</div>
@if (item.DurationDays is not null)
{
<div class="text-on-surface-variant font-label-xs text-label-xs">Thời gian dùng: @item.DurationDays ngày</div>
}
</td>
<td class="py-3.5 px-3">
<div class="text-on-surface font-medium">@(item.Dosage ?? "—")</div>
<div class="text-on-surface-variant font-label-xs text-label-xs">@(item.Instruction ?? "")</div>
</td>
<td class="py-3.5 px-3 text-center font-bold text-on-surface text-base">@item.Quantity</td>
<td class="py-3.5 px-3">
<span class="font-mono font-semibold text-on-surface">@(batchNo ?? "—")</span>
</td>
<td class="py-3.5 px-4 text-center">
@if (batchNo is not null)
{
<span class="inline-flex items-center gap-1 px-space-xs py-0.5 rounded-full bg-surface-container-high text-primary font-label-xs text-[11px] font-semibold">
<span class="material-symbols-outlined text-[14px]">check_circle</span>
<span>Đã phát</span>
</span>
}
else
{
<span class="inline-flex items-center gap-1 px-space-xs py-0.5 rounded-full bg-surface-container-highest text-tertiary font-label-xs text-[11px] font-semibold">
<span class="material-symbols-outlined text-[14px]">hourglass_empty</span>
<span>Chờ phát</span>
</span>
}
</td>
</tr>
}
}
</tbody>
</table>
</div>
</div>
