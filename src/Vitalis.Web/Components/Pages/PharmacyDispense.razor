<script src="js/pages/PharmacyDispense.js"></script>

@code {
    private string MedicalRecordIdInput { get; set; } = "";
    private bool IsLoading { get; set; }
    private string? LoadError { get; set; }
    private MedicalRecordDto? Record { get; set; }

    private bool IsDispensing { get; set; }
    private string? DispenseError { get; set; }
    private DispenseResultDto? DispenseResult { get; set; }

    private bool IsDispensed => Record?.Prescription?.Status == PrescriptionStatus.Dispensed || DispenseResult is not null;

    private async Task LookupAsync()
    {
        if (!int.TryParse(MedicalRecordIdInput, out var id))
        {
            LoadError = "Vui lòng nhập mã bệnh án hợp lệ (số nguyên).";
            return;
        }

        LoadError = null;
        DispenseError = null;
        DispenseResult = null;
        IsLoading = true;
        try
        {
            Record = await Api.GetAsync<MedicalRecordDto>($"api/medical-records/{id}");
        }
        catch (ApiException ex)
        {
            Record = null;
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task DispenseAsync()
    {
        if (Record?.Prescription is null)
            return;

        DispenseError = null;
        IsDispensing = true;
        try
        {
            DispenseResult = await Api.PostAsync<object, DispenseResultDto>(
                $"api/prescriptions/{Record.Prescription.Id}/dispense", new { });
        }
        catch (ApiException ex)
        {
            DispenseError = ex.Message;
        }
        finally
        {
            IsDispensing = false;
        }
    }

    private string? BatchNoFor(int prescriptionItemId) =>
        DispenseResult?.Allocations.FirstOrDefault(a => a.PrescriptionItemId == prescriptionItemId)?.BatchNo;
}
