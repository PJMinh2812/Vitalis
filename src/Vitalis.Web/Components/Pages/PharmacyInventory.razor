<script src="js/pages/PharmacyInventory.js"></script>

@code {
    private List<MedicineInventoryDto> AllItems { get; set; } = [];
    private bool IsLoading { get; set; } = true;
    private string? LoadError { get; set; }
    private string SearchText { get; set; } = "";
    private InventoryStatusFilter StatusFilter { get; set; } = InventoryStatusFilter.All;

    private int LowStockCount => AllItems.Count(m => m.LowStock);
    private int NearExpiryCount => AllItems.Count(m => m.NearExpiry);

    private List<MedicineInventoryDto> FilteredItems => AllItems
        .Where(m => StatusFilter switch
        {
            InventoryStatusFilter.LowStock => m.LowStock,
            InventoryStatusFilter.NearExpiry => m.NearExpiry,
            _ => true,
        })
        .Where(m => string.IsNullOrWhiteSpace(SearchText)
            || m.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
            || (m.ActiveIngredient?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || (m.Code?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private int? TransactionsMedicineId { get; set; }
    private string? TransactionsMedicineName { get; set; }
    private List<StockTransactionDto> Transactions { get; set; } = [];

    private MedicineInventoryDto? AdjustingMedicine { get; set; }
    private string AdjustBatchId { get; set; } = "";
    private string AdjustQuantity { get; set; } = "";
    private string AdjustReason { get; set; } = "";
    private bool IsAdjusting { get; set; }
    private string? AdjustError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadInventoryAsync();
    }

    private async Task LoadInventoryAsync()
    {
        IsLoading = true;
        LoadError = null;
        try
        {
            AllItems = (await Api.GetAsync<List<MedicineInventoryDto>>("api/medicines/inventory")).ToList();
        }
        catch (ApiException ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ViewTransactionsAsync(int medicineId)
    {
        TransactionsMedicineId = medicineId;
        TransactionsMedicineName = AllItems.FirstOrDefault(m => m.Id == medicineId)?.Name;
        try
        {
            Transactions = (await Api.GetAsync<List<StockTransactionDto>>($"api/medicines/{medicineId}/transactions"))
                .OrderByDescending(t => t.CreatedAt)
                .ToList();
        }
        catch (ApiException ex)
        {
            LoadError = ex.Message;
            Transactions = [];
        }
    }

    private void OpenAdjustForm(MedicineInventoryDto medicine)
    {
        AdjustingMedicine = medicine;
        AdjustBatchId = "";
        AdjustQuantity = "";
        AdjustReason = "";
        AdjustError = null;
    }

    private void CloseAdjustForm()
    {
        AdjustingMedicine = null;
    }

    private async Task SubmitAdjustAsync()
    {
        if (AdjustingMedicine is null)
            return;

        if (!int.TryParse(AdjustBatchId, out var batchId) || !int.TryParse(AdjustQuantity, out var quantity) || string.IsNullOrWhiteSpace(AdjustReason))
        {
            AdjustError = "Vui lòng nhập đầy đủ mã lô, số lượng và lý do hợp lệ.";
            return;
        }

        IsAdjusting = true;
        AdjustError = null;
        try
        {
            await Api.PostNoContentAsync($"api/medicines/{AdjustingMedicine.Id}/adjust",
                new AdjustStockRequest(batchId, quantity, AdjustReason));
            AdjustingMedicine = null;
            await LoadInventoryAsync();
        }
        catch (ApiException ex)
        {
            AdjustError = ex.Message;
        }
        finally
        {
            IsAdjusting = false;
        }
    }

    private enum InventoryStatusFilter
    {
        All,
        LowStock,
        NearExpiry,
    }
}
