@page "/pharmacy/inventory"
@layout PharmacyLayout
@attribute [Authorize(Roles = "Pharmacist")]
@using Vitalis.Application.DTOs.Pharmacy
@using Vitalis.Domain.Enums
@inject VitalisApiClient Api
@inject NavigationManager Navigation

<PageTitle>Kho thuốc · Vitalis</PageTitle>

<div class="flex flex-col w-full">

@if (LoadError is not null)
{
<div class="mx-margin mt-space-md flex items-start gap-3 p-3.5 rounded-xl bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-xl shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@LoadError</p>
<button class="text-on-error-container hover:opacity-75" @onclick="() => LoadError = null" type="button">
<span class="material-symbols-outlined text-base">close</span>
</button>
</div>
}
@if (AdjustError is not null)
{
<div class="mx-margin mt-space-md flex items-start gap-3 p-3.5 rounded-xl bg-error-container text-on-error-container shadow-sm">
<span class="material-symbols-outlined text-error text-xl shrink-0 mt-0.5">error</span>
<p class="flex-1 font-body-sm text-body-sm">@AdjustError</p>
<button class="text-on-error-container hover:opacity-75" @onclick="() => AdjustError = null" type="button">
<span class="material-symbols-outlined text-base">close</span>
</button>
</div>
}
<!-- Workspace Sub-Header & Breadcrumb Bar -->
<div class="px-margin pt-space-lg pb-space-md flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
<div class="flex flex-col gap-1 min-w-0">
<div class="flex items-center gap-space-xs font-label-xs text-label-xs text-on-surface-variant">
<span class="inline-flex items-center gap-1 font-semibold text-primary">
<span class="material-symbols-outlined text-[15px]">inventory_2</span>
          VC-18
        </span>
<span class="text-outline-variant">/</span>
<span>Phân hệ Dược</span>
<span class="text-outline-variant">/</span>
<span class="text-on-surface font-medium">Quản lý kho &amp; Tồn kho biệt dược</span>
</div>
<div class="flex items-center gap-space-sm flex-wrap">
<h1 class="font-headline-md text-headline-md text-on-surface tracking-tight font-bold">
          Quản trị Kho Dược &amp; Cảnh báo Tồn
        </h1>
<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-label-xs text-label-xs bg-primary-fixed text-on-primary-fixed font-semibold">
<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
          Đồng bộ thời gian thực GSP
        </span>
<span class="font-label-xs text-label-xs text-on-surface-variant">
          Cập nhật: <span class="font-medium text-on-surface">09:45:18 - 24/10/2026</span>
</span>
</div>
</div>
<!-- Quick Operations Command Buttons -->
<div class="flex items-center gap-space-sm flex-wrap shrink-0">
<button class="inline-flex items-center gap-1.5 px-space-md py-2 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md shadow-sm hover:bg-surface-container transition-colors" type="button">
<span class="material-symbols-outlined text-[18px] text-on-surface-variant">swap_horiz</span>
<span>Xuất chuyển kho</span>
</button>
<button class="inline-flex items-center gap-1.5 px-space-md py-2 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md shadow-sm hover:bg-surface-container transition-colors" type="button">
<span class="material-symbols-outlined text-[18px] text-on-surface-variant">checklist</span>
<span>Kiểm kê định kỳ</span>
</button>
<button class="inline-flex items-center gap-1.5 px-space-md py-2 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md shadow-sm hover:bg-surface-container transition-colors" type="button">
<span class="material-symbols-outlined text-[18px] text-on-surface-variant">file_download</span>
<span>Xuất file BHYT</span>
</button>
<button class="inline-flex items-center gap-1.5 px-space-md py-2 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md shadow-sm hover:bg-primary transition-colors" @onclick='() => Navigation.NavigateTo("/pharmacy/receipt")' type="button">
<span class="material-symbols-outlined text-[18px]">add_circle</span>
<span>+ Nhập kho mới (F2)</span>
</button>
</div>
</div>
<!-- Main Workstation Viewport -->
<div class="px-margin space-y-space-lg pb-space-xl">
<!-- 1. Top KPI Summary Metric Cards -->
<section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-gutter">
<!-- KPI 1: Tổng giá trị tồn -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-shadow">
<div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-primary/5 group-hover:scale-110 transition-transform"></div>
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant font-bold">Tổng giá trị tồn kho</span>
<div class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight">
              1.485.600.000 <span class="font-label-sm text-label-sm text-on-surface-variant font-normal">đ</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-primary-fixed/50 flex items-center justify-center text-primary shrink-0">
<span class="material-symbols-outlined text-[22px]">account_balance_wallet</span>
</div>
</div>
<div class="mt-space-md pt-space-xs flex items-center justify-between font-label-xs text-label-xs text-on-surface-variant">
<span class="flex items-center gap-1">
<span class="inline-block w-2 h-2 rounded-full bg-primary"></span>
<b>418</b> hoạt chất
          </span>
<span class="text-outline-variant">•</span>
<span><b>682</b> biệt dược lưu kho</span>
<span class="text-primary font-semibold flex items-center">
<span class="material-symbols-outlined text-[14px]">trending_up</span>+2.4%
          </span>
</div>
</div>
<!-- KPI 2: Dưới định mức (Low Stock) -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-shadow">
<div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-error/5 group-hover:scale-110 transition-transform"></div>
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-xs text-label-xs uppercase tracking-wider text-error font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">warning</span>
              Dưới định mức tồn (Min)
            </span>
<div class="font-headline-lg text-headline-lg text-error font-bold tracking-tight flex items-baseline gap-2">
              @LowStockCount.ToString("00") <span class="font-title-md text-title-md text-on-surface font-semibold">mặt hàng</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-error-container/60 flex items-center justify-center text-error shrink-0">
<span class="material-symbols-outlined text-[22px]">production_quantity_limits</span>
</div>
</div>
<div class="mt-space-md pt-space-xs flex items-center justify-between font-label-xs text-label-xs">
<a class="text-primary hover:underline font-semibold flex items-center gap-0.5 ml-auto" href="#inventory-table">
            Xem ngay <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
</a>
</div>
</div>
<!-- KPI 3: Cận hạn dùng (Expiring Soon) -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-shadow">
<div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-secondary/5 group-hover:scale-110 transition-transform"></div>
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-xs text-label-xs uppercase tracking-wider text-secondary font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">schedule</span>
              Cận hạn sử dụng (&lt; 90 ngày)
            </span>
<div class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight flex items-baseline gap-2">
              @NearExpiryCount.ToString("00") <span class="font-title-md text-title-md text-on-surface font-semibold">mặt hàng</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-secondary-fixed/50 flex items-center justify-center text-secondary shrink-0">
<span class="material-symbols-outlined text-[22px]">notification_important</span>
</div>
</div>
<div class="mt-space-md pt-space-xs flex items-center justify-between font-label-xs text-label-xs text-on-surface-variant">
<span class="px-2 py-0.5 rounded-full bg-surface-container text-secondary font-semibold ml-auto">
            FEFO Active
          </span>
</div>
</div>
<!-- KPI 4: Tỷ lệ luân chuyển kho -->
<div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-shadow">
<div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-tertiary/5 group-hover:scale-110 transition-transform"></div>
<div class="flex items-start justify-between">
<div class="flex flex-col gap-1">
<span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant font-bold">Tỷ lệ luân chuyển (Turnover)</span>
<div class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight flex items-baseline gap-2">
              4.6 <span class="font-title-md text-title-md text-on-surface font-medium">vòng / năm</span>
</div>
</div>
<div class="w-10 h-10 rounded-lg bg-tertiary-fixed/50 flex items-center justify-center text-tertiary shrink-0">
<span class="material-symbols-outlined text-[22px]">autorenew</span>
</div>
</div>
<div class="mt-space-md pt-space-xs flex items-center justify-between font-label-xs text-label-xs text-on-surface-variant">
<span class="text-tertiary font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[15px]">verified</span>
            Đạt tiêu chuẩn GSP Dược
          </span>
<span>Dự phòng: <b>45 ngày</b></span>
</div>
</div>
</section>
<!-- 2. Integrated Filter & Clinical Query Bar -->
<section class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-md">
<div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
<!-- Live Search Field -->
<div class="relative flex-1 min-w-[280px]">
<span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]">search</span>
<input class="w-full h-10 pl-10 pr-10 bg-surface rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant outline-none focus:bg-surface-container-low transition-all" id="table-search" placeholder="Tìm theo tên biệt dược, hoạt chất, mã thuốc..." type="text" @bind="SearchText" @bind:event="oninput"/>
</div>
<!-- Filter Selects -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
<!-- Kho lưu trữ -->
<div class="relative">
<select class="w-full h-10 px-3 py-2 bg-surface rounded-lg font-label-sm text-label-sm text-on-surface outline-none cursor-pointer appearance-none pr-8 hover:bg-surface-container-low transition-colors">
<option value="">Tất cả kho dược (03 kho)</option>
<option selected="" value="kho-tong">Kho chính tổng hợp</option>
<option value="kho-ngoai-tru">Kho chẵn ngoại trú</option>
<option value="tu-cap-cuu">Tủ cấp cứu P.Cấp cứu</option>
</select>
<span class="material-symbols-outlined absolute right-2.5 top-2.5 text-[18px] text-on-surface-variant pointer-events-none">expand_more</span>
</div>
<!-- Nhóm dược lý -->
<div class="relative">
<select class="w-full h-10 px-3 py-2 bg-surface rounded-lg font-label-sm text-label-sm text-on-surface outline-none cursor-pointer appearance-none pr-8 hover:bg-surface-container-low transition-colors">
<option value="">Tất cả nhóm dược lý</option>
<option value="tim-mach">Tim mạch &amp; Huyết áp</option>
<option value="khang-sinh">Kháng sinh &amp; Kháng khuẩn</option>
<option value="tieu-hoa">Tiêu hóa &amp; Gan mật</option>
<option value="dai-thao-duong">Đái tháo đường &amp; Nội tiết</option>
<option value="than-kinh">Thần kinh - Tâm thần</option>
<option value="ha-sot">Hạ sốt - Giảm đau - NSAID</option>
</select>
<span class="material-symbols-outlined absolute right-2.5 top-2.5 text-[18px] text-on-surface-variant pointer-events-none">expand_more</span>
</div>
<!-- Phân loại quản lý -->
<div class="relative">
<select class="w-full h-10 px-3 py-2 bg-surface rounded-lg font-label-sm text-label-sm text-on-surface outline-none cursor-pointer appearance-none pr-8 hover:bg-surface-container-low transition-colors">
<option value="">Tất cả phân loại</option>
<option value="bhyt">Thuốc BHYT thanh toán</option>
<option value="tu-tra">Thuốc tự chi trả / Dịch vụ</option>
<option value="ks-dac-biet">Thuốc kiểm soát đặc biệt</option>
<option value="vat-tu">Vật tư y tế tiêu hao</option>
</select>
<span class="material-symbols-outlined absolute right-2.5 top-2.5 text-[18px] text-on-surface-variant pointer-events-none">expand_more</span>
</div>
<!-- Trạng thái tồn -->
<div class="relative">
<select class="w-full h-10 px-3 py-2 bg-surface rounded-lg font-label-sm text-label-sm text-on-surface outline-none cursor-pointer appearance-none pr-8 hover:bg-surface-container-low transition-colors font-medium" @bind="StatusFilter">
<option value="@InventoryStatusFilter.All">Mọi mức độ tồn kho</option>
<option value="@InventoryStatusFilter.LowStock">Dưới định mức min (Low)</option>
<option value="@InventoryStatusFilter.NearExpiry">Cận date (&lt; 90 ngày)</option>
</select>
<span class="material-symbols-outlined absolute right-2.5 top-2.5 text-[18px] text-on-surface-variant pointer-events-none">expand_more</span>
</div>
</div>
</div>
<!-- Quick Filter Chips & Table Controls -->
<div class="flex items-center justify-between flex-wrap gap-space-sm pt-space-xs">
<div class="flex items-center gap-1.5 flex-wrap">
<span class="font-label-xs text-label-xs text-on-surface-variant mr-1">Bộ lọc nhanh:</span>
<button class="px-3 py-1 rounded-full font-label-xs text-label-xs font-semibold transition-colors @(StatusFilter == InventoryStatusFilter.All ? "bg-primary-container text-on-primary shadow-xs" : "bg-surface-container text-on-surface-variant hover:bg-surface-container-highest")" @onclick='() => StatusFilter = InventoryStatusFilter.All' type="button">
            Tất cả (@AllItems.Count)
          </button>
<button class="px-3 py-1 rounded-full font-label-xs text-label-xs font-semibold transition-colors @(StatusFilter == InventoryStatusFilter.LowStock ? "bg-error-container text-error shadow-xs" : "bg-surface-container text-on-surface-variant hover:bg-error-container hover:text-error")" @onclick='() => StatusFilter = InventoryStatusFilter.LowStock' type="button">
            Cần đặt gấp (@LowStockCount)
          </button>
<button class="px-3 py-1 rounded-full font-label-xs text-label-xs font-semibold transition-colors @(StatusFilter == InventoryStatusFilter.NearExpiry ? "bg-secondary-container text-on-secondary-container shadow-xs" : "bg-surface-container text-on-surface-variant hover:bg-secondary-container hover:text-on-secondary-container")" @onclick='() => StatusFilter = InventoryStatusFilter.NearExpiry' type="button">
            Hạn dùng &lt; 90 ngày (@NearExpiryCount)
          </button>
</div>
<div class="flex items-center gap-space-sm font-label-xs text-label-xs text-on-surface-variant">
<span>Quy tắc xuất kho: <b class="text-primary">FEFO (Hạn ngắn xuất trước)</b></span>
<span class="text-outline-variant">|</span>
<button class="hover:text-primary flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">tune</span> Cấu hình cột hiển thị
          </button>
</div>
</div>
</section>
<!-- 3. Medicine Inventory Data Table (High Density Clinical View) -->
<section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col" id="inventory-table">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse min-w-[1240px]">
<thead>
<tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
<th class="py-3 px-4 min-w-[240px]">Biệt dược / Hoạt chất / Mã</th>
<th class="py-3 px-3 min-w-[170px]">Tồn khả dụng / Định mức</th>
<th class="py-3 px-3 min-w-[150px]">Hạn dùng gần nhất</th>
<th class="py-3 px-3 text-center">Trạng thái tồn</th>
<th class="py-3 px-4 text-center w-40">Thao tác</th>
</tr>
</thead>
<tbody class="divide-y-0 text-on-surface font-body-sm text-body-sm">
@if (IsLoading)
{
<tr><td colspan="5" class="py-6 px-4 text-center text-on-surface-variant">Đang tải danh sách thuốc...</td></tr>
}
else if (FilteredItems.Count == 0)
{
<tr><td colspan="5" class="py-6 px-4 text-center text-on-surface-variant">Không tìm thấy thuốc phù hợp.</td></tr>
}
else
{
@foreach (var med in FilteredItems)
{
var rowClass = med.LowStock ? "hover:bg-error-container/20 transition-colors group bg-error-container/5"
    : med.NearExpiry ? "hover:bg-surface-container-high/60 transition-colors group bg-secondary-fixed/10"
    : "hover:bg-surface-container-low/70 transition-colors group";
<tr class="@rowClass">
<td class="py-3 px-4">
<div class="flex flex-col">
<span class="font-title-md text-title-md @(med.LowStock ? "text-error" : "text-primary") font-bold tracking-tight">
                    @med.Name
                  </span>
@if (med.ActiveIngredient is not null)
{
<span class="font-label-xs text-label-xs text-on-surface-variant">@med.ActiveIngredient</span>
}
@if (med.Code is not null)
{
<span class="font-label-xs text-[10px] text-outline font-mono mt-0.5">Mã: @med.Code</span>
}
</div>
</td>
<td class="py-3 px-3">
<div class="flex flex-col gap-1">
<div class="flex justify-between items-baseline font-label-xs text-label-xs">
<span class="font-bold @(med.LowStock ? "text-error" : "text-on-surface") text-[14px]">@med.TotalStock</span>
<span class="@(med.LowStock ? "text-error font-medium" : "text-on-surface-variant")">Min: @(med.MinStock?.ToString() ?? "—")</span>
</div>
</div>
</td>
<td class="py-3 px-3">
@if (med.NearestExpiry is not null)
{
<div class="flex items-center gap-1 text-label-xs font-medium @(med.NearExpiry ? "text-error" : "text-tertiary")">
<span class="material-symbols-outlined text-[13px]">event_available</span>
<span>@med.NearestExpiry.Value.ToString("dd/MM/yyyy")</span>
</div>
}
else
{
<span class="text-on-surface-variant font-label-xs text-label-xs">—</span>
}
</td>
<td class="py-3 px-3 text-center">
@if (med.LowStock)
{
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-xs text-[11px] font-semibold bg-[#FEE2E2] text-[#991B1B]">
<span class="w-1.5 h-1.5 rounded-full bg-[#991B1B] animate-pulse"></span>
                  DƯỚI ĐỊNH MỨC
                </span>
}
else if (med.NearExpiry)
{
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-xs text-[11px] font-semibold bg-[#FEF3C7] text-[#92400E]">
<span class="w-1.5 h-1.5 rounded-full bg-[#92400E]"></span>
                  CẬN HẠN DÙNG
                </span>
}
else
{
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-xs text-[11px] font-semibold bg-[#DCFCE7] text-[#166534]">
<span class="w-1.5 h-1.5 rounded-full bg-[#166534]"></span>
                  Tồn an toàn
                </span>
}
</td>
<td class="py-3 px-4 text-center">
<div class="flex items-center justify-center gap-1">
<button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors" title="Xem thẻ kho" @onclick="() => ViewTransactionsAsync(med.Id)" type="button">
<span class="material-symbols-outlined text-[18px]">receipt_long</span>
</button>
<button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-error transition-colors" title="Điều chỉnh kho (xuất huỷ)" @onclick="() => OpenAdjustForm(med)" type="button">
<span class="material-symbols-outlined text-[18px]">remove_circle</span>
</button>
</div>
</td>
</tr>
}
}
</tbody>
</table>
</div>
<!-- Professional Clinical Table Pagination Bar -->
<div class="px-space-md py-3 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-space-sm font-label-sm text-label-sm text-on-surface-variant">
<div class="flex items-center gap-space-md">
<span>Hiển thị <b class="text-on-surface">@FilteredItems.Count</b> trong tổng số <b class="text-on-surface">@AllItems.Count</b> biệt dược</span>
</div>
<div class="flex items-center gap-1">
<button class="px-2.5 py-1 rounded bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors flex items-center gap-0.5">
<span class="material-symbols-outlined text-[16px]">chevron_left</span> Trước
          </button>
<button class="w-8 h-8 rounded bg-primary-container text-on-primary font-bold flex items-center justify-center">1</button>
<button class="w-8 h-8 rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container flex items-center justify-center transition-colors">2</button>
<button class="w-8 h-8 rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container flex items-center justify-center transition-colors">3</button>
<span class="px-1 text-outline">...</span>
<button class="w-8 h-8 rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container flex items-center justify-center transition-colors">69</button>
<button class="px-2.5 py-1 rounded bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors flex items-center gap-0.5">
