@page "/reception/cashier"
@layout ReceptionLayout
@attribute [Authorize(Roles = "Receptionist")]
@inject VitalisApiClient Api
@using Vitalis.Application.DTOs.Billing
@using Vitalis.Domain.Enums

<PageTitle>Thu ngân · Vitalis</PageTitle>

<div class="flex flex-col w-full">
<div class="p-space-lg bg-surface flex flex-col gap-space-md">
<div class="flex flex-wrap items-center justify-between gap-space-md">
<div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Thu ngân &amp; Viện phí</h1>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          Tra cứu hóa đơn theo mã số và ghi nhận thanh toán viện phí
        </p>
</div>
</div>
</div>
<div class="px-space-lg pb-space-xl grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
<!-- LEFT COLUMN: Lookup -->
<div class="lg:col-span-4 flex flex-col gap-space-md">
<div class="bg-surface-container-lowest rounded-xl shadow-sm p-space-md flex flex-col gap-space-sm">
<label class="font-label-sm text-label-sm text-on-surface-variant font-semibold">Tra cứu hóa đơn theo ID</label>
<div class="flex items-center gap-2">
<input class="w-full h-10 px-3 rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary shadow-sm" placeholder="Nhập ID hóa đơn..." type="number" @bind="LookupId" @onkeyup="OnLookupKeyUp"/>
<button class="px-4 h-10 rounded-lg bg-primary text-on-primary font-label-sm text-label-sm font-semibold shrink-0 disabled:opacity-60" disabled="@IsLoading" @onclick="LookupAsync">Tìm</button>
</div>
@if (LookupError is not null)
{
<div class="p-2.5 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@LookupError</div>
}
</div>
@if (RecentInvoices.Count > 0)
{
<div class="flex flex-col gap-2.5">
<span class="font-label-xs text-label-xs text-on-surface-variant font-semibold uppercase px-1">Đã xem trong phiên này</span>
@foreach (var inv in RecentInvoices)
{
<div class="p-space-md rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow cursor-pointer relative @(Invoice?.Id == inv.Id ? "bg-gradient-to-r from-primary/5 via-surface-container-lowest to-surface-container-lowest" : "")" @onclick="() => SelectRecent(inv)">
@if (Invoice?.Id == inv.Id)
{
<div class="absolute left-0 top-3 bottom-3 w-1.5 rounded-r bg-primary"></div>
}
<div class="flex items-start justify-between gap-2">
<div class="flex flex-col min-w-0">
<div class="flex items-center gap-1.5">
<span class="font-label-sm text-label-sm font-bold text-primary">@(inv.InvoiceNo ?? $"HD-{inv.Id}")</span>
</div>
<h2 class="font-title-md text-title-md text-on-surface font-bold truncate mt-0.5">@inv.PatientName</h2>
</div>
<span class="inline-flex items-center px-2 py-0.5 rounded-full font-label-xs text-label-xs whitespace-nowrap @InvoiceStatusClass(inv)">@InvoiceStatusLabel(inv)</span>
</div>
<div class="mt-2.5 pt-2.5 border-t border-surface-container-low flex items-center justify-between">
<span class="font-headline-sm text-headline-sm font-bold text-primary">@FormatCurrency(inv.Remaining)</span>
</div>
</div>
}
</div>
}
</div>
<!-- RIGHT COLUMN: Invoice Detail -->
<div class="lg:col-span-8 flex flex-col gap-space-md">
@if (Invoice is null)
{
<div class="bg-surface-container-lowest rounded-xl shadow-sm p-space-lg flex items-center justify-center text-on-surface-variant font-body-md text-body-md min-h-[300px]">
    Nhập ID hóa đơn bên trái để tra cứu
  </div>
}
else
{
<div class="bg-surface-container-lowest rounded-xl shadow-sm p-space-lg flex flex-col gap-space-md">
<div class="flex flex-wrap items-start justify-between gap-space-md pb-space-sm border-b border-surface-container-low">
<div>
<div class="flex items-center gap-space-sm flex-wrap">
<h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">
                Hóa đơn viện phí: @(Invoice.InvoiceNo ?? $"HD-{Invoice.Id}")
              </h2>
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-xs text-label-xs font-semibold @InvoiceStatusClass(Invoice)">@InvoiceStatusLabel(Invoice)</span>
</div>
<div class="flex items-center gap-3 text-on-surface-variant font-label-xs text-label-xs mt-1">
<span>Lập lúc: @(Invoice.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm"))</span>
<span>•</span>
<span>Bệnh nhân: @Invoice.PatientName</span>
</div>
</div>
@if (Invoice.PaidAmount == 0 && !Invoice.IsCancelled)
{
<div class="flex items-center gap-2">
<button class="p-1.5 rounded-lg bg-surface-container-low text-error hover:bg-error-container hover:text-on-error-container transition-colors" title="Hủy hóa đơn" @onclick="() => ShowCancelModal = true">
<span class="material-symbols-outlined text-[18px]">delete</span>
</button>
</div>
}
</div>
<!-- Line Items Table -->
<div class="flex flex-col overflow-hidden rounded-xl shadow-sm bg-surface-container-lowest">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-low text-on-surface-variant font-label-xs text-label-xs uppercase tracking-wider">
<th class="py-3 px-3 w-12 text-center">STT</th>
<th class="py-3 px-3">Mô tả</th>
<th class="py-3 px-3 text-center">SL</th>
<th class="py-3 px-3 text-right">Đơn giá</th>
<th class="py-3 px-3 text-right font-bold text-on-surface">Thành tiền</th>
</tr>
</thead>
<tbody class="divide-y divide-surface-container-low font-body-sm text-body-sm text-on-surface">
@{ var stt = 0; }
@foreach (var item in Invoice.Items)
{
stt++;
<tr class="hover:bg-surface-container-low/50 transition-colors">
<td class="py-2.5 px-3 text-center text-on-surface-variant font-label-xs text-label-xs">@stt.ToString("00")</td>
<td class="py-2.5 px-3">
<div class="font-label-sm text-label-sm font-semibold text-on-surface">@(item.Description ?? "—")</div>
</td>
<td class="py-2.5 px-3 text-center font-medium">@item.Quantity</td>
<td class="py-2.5 px-3 text-right text-on-surface-variant">@FormatCurrency(item.UnitPrice)</td>
<td class="py-2.5 px-3 text-right font-bold text-primary">@FormatCurrency(item.Amount)</td>
</tr>
}
</tbody>
</table>
</div>
<!-- Financial Calculation Breakdown -->
<div class="p-space-md bg-surface-container-low/60 flex flex-col md:flex-row justify-between items-center gap-space-md">
<div class="text-on-surface-variant font-label-xs text-label-xs flex items-center gap-2">
<span class="material-symbols-outlined text-[16px] text-primary">receipt_long</span>
              Hóa đơn gồm @Invoice.Items.Count hạng mục
            </div>
<div class="w-full md:w-80 flex flex-col gap-1.5">
<div class="flex justify-between font-body-sm text-body-sm">
<span class="text-on-surface-variant">Tổng chi phí phát sinh:</span>
<span class="font-semibold text-on-surface">@FormatCurrency(Invoice.TotalAmount)</span>
</div>
<div class="flex justify-between font-body-sm text-body-sm">
<span class="text-emerald-700">Giảm trừ BHYT:</span>
<span class="font-semibold text-emerald-700">-@FormatCurrency(Invoice.InsuranceAmount)</span>
</div>
<div class="flex justify-between font-body-sm text-body-sm">
<span class="text-on-surface-variant">Ưu đãi / Giảm giá:</span>
<span class="text-on-surface-variant">-@FormatCurrency(Invoice.DiscountAmount)</span>
</div>
<div class="flex justify-between font-body-sm text-body-sm">
<span class="text-on-surface-variant">Đã thanh toán:</span>
<span class="text-on-surface-variant">@FormatCurrency(Invoice.PaidAmount)</span>
</div>
<div class="pt-2 border-t border-surface-container-high flex justify-between items-baseline">
<span class="font-label-md text-label-md font-bold text-on-surface">CÒN LẠI CẦN THU:</span>
<span class="font-headline-md text-headline-md font-bold text-primary">@FormatCurrency(Invoice.Remaining)</span>
</div>
</div>
</div>
</div>
@if (Invoice.Remaining > 0 && !Invoice.IsCancelled)
{
<!-- PAYMENT METHOD SELECTION -->
<div class="flex flex-col gap-space-sm pt-space-xs">
<span class="font-label-sm text-label-sm font-bold text-on-surface uppercase tracking-wider">
              Chọn phương thức thu viện phí
            </span>
<div class="grid grid-cols-3 gap-2 p-1 rounded-xl bg-surface-container-low">
<button class="py-2.5 px-3 rounded-lg font-label-sm text-label-sm font-bold flex items-center justify-center gap-2 transition-all @(SelectedMethod == PaymentMethod.BankTransfer ? "bg-surface-container-lowest text-primary shadow-sm" : "text-on-surface-variant hover:text-on-surface")" @onclick="() => SelectedMethod = PaymentMethod.BankTransfer">
<span class="material-symbols-outlined text-[18px]">qr_code_scanner</span>
<span>Chuyển khoản</span>
</button>
<button class="py-2.5 px-3 rounded-lg font-label-sm text-label-sm font-semibold flex items-center justify-center gap-2 transition-all @(SelectedMethod == PaymentMethod.Cash ? "bg-surface-container-lowest text-primary shadow-sm" : "text-on-surface-variant hover:text-on-surface")" @onclick="() => SelectedMethod = PaymentMethod.Cash">
<span class="material-symbols-outlined text-[18px]">payments</span>
<span>Tiền mặt</span>
</button>
<button class="py-2.5 px-3 rounded-lg font-label-sm text-label-sm font-semibold flex items-center justify-center gap-2 transition-all @(SelectedMethod == PaymentMethod.Card ? "bg-surface-container-lowest text-primary shadow-sm" : "text-on-surface-variant hover:text-on-surface")" @onclick="() => SelectedMethod = PaymentMethod.Card">
<span class="material-symbols-outlined text-[18px]">credit_card</span>
<span>Máy quẹt thẻ POS</span>
</button>
</div>
@if (SelectedMethod == PaymentMethod.Cash)
{
<div class="p-space-md rounded-xl bg-surface-container-low flex flex-col gap-space-sm">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant font-semibold">Số tiền cần thu:</label>
<input class="h-10 px-3 rounded-lg bg-surface-container-lowest font-bold text-headline-sm text-primary border-0 shadow-sm" readonly value="@FormatCurrency(Invoice.Remaining)" type="text"/>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-xs text-label-xs text-on-surface-variant font-semibold">Khách đưa (VNĐ):</label>
<input class="h-10 px-3 rounded-lg bg-surface-container-lowest font-bold text-headline-sm text-on-surface border-0 shadow-sm focus:ring-2 focus:ring-primary" type="number" @bind="CashGiven"/>
</div>
</div>
<div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between shadow-sm">
<span class="font-label-sm text-label-sm font-semibold text-on-surface">Tiền thừa trả lại bệnh nhân:</span>
<span class="font-headline-sm text-headline-sm font-bold text-emerald-700">@FormatCurrency(Math.Max(0, CashGiven - Invoice.Remaining))</span>
</div>
</div>
}
else
{
<div class="p-space-md rounded-xl bg-surface-container-low flex flex-col gap-space-sm">
<label class="font-label-xs text-label-xs text-on-surface-variant font-semibold">Mã giao dịch / Mã chuẩn chi:</label>
<input class="h-10 px-3 rounded-lg bg-surface-container-lowest font-body-sm text-body-sm text-on-surface border-0 shadow-sm" placeholder="Nhập mã giao dịch..." type="text" @bind="ReferenceCode"/>
</div>
}
</div>
@if (PaymentError is not null)
{
<div class="p-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@PaymentError</div>
}
<div class="pt-space-md border-t border-surface-container-low flex items-center justify-end gap-space-md">
<button class="px-6 py-2.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold transition-all shadow-md flex items-center gap-2 disabled:opacity-60" disabled="@IsPaying" @onclick="ConfirmPaymentAsync">
<span class="material-symbols-outlined text-[20px]">task_alt</span>
<span>@(IsPaying ? "Đang xử lý..." : $"Xác nhận thu {FormatCurrency(Invoice.Remaining)}")</span>
</button>
</div>
}
else if (Invoice.IsCancelled)
{
<div class="p-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">Hóa đơn này đã bị hủy.</div>
}
else
{
<div class="p-3 rounded-lg bg-emerald-100 text-emerald-800 font-body-sm text-body-sm">Hóa đơn đã được thanh toán đầy đủ.</div>
}
</div>
}
</div>
</div>
</div>

@if (ShowCancelModal && Invoice is not null)
{
<div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/40 backdrop-blur-sm p-4">
<div class="bg-surface-container-lowest rounded-xl shadow-2xl max-w-md w-full p-6 flex flex-col gap-4">
<span class="font-title-md text-title-md font-bold text-on-surface">Hủy hóa đơn @(Invoice.InvoiceNo ?? $"HD-{Invoice.Id}")</span>
<div class="flex flex-col gap-2">
<label class="font-label-md text-label-md text-on-surface font-medium">Lý do hủy <span class="text-error">*</span></label>
<textarea class="w-full p-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:outline-none focus:ring-1 focus:ring-primary resize-none" rows="2" @bind="CancelReason"></textarea>
</div>
@if (PaymentError is not null)
{
<div class="p-2.5 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@PaymentError</div>
}
<div class="flex items-center justify-end gap-2 pt-2">
<button class="px-4 py-2 rounded-lg bg-surface-container-low text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-semibold transition-colors" @onclick="() => ShowCancelModal = false">Hủy bỏ</button>
<button class="px-4 py-2 rounded-lg bg-error text-on-error hover:bg-error-container hover:text-on-error-container font-label-md text-label-md font-semibold transition-colors shadow-sm" @onclick="ConfirmCancelInvoiceAsync">Xác nhận hủy hóa đơn</button>
</div>
</div>
</div>
}

@code {
    private int LookupId { get; set; }
    private bool IsLoading { get; set; }
    private string? LookupError { get; set; }
    private InvoiceDto? Invoice { get; set; }
    private List<InvoiceDto> RecentInvoices { get; set; } = new();

    private PaymentMethod SelectedMethod { get; set; } = PaymentMethod.BankTransfer;
    private decimal CashGiven { get; set; }
    private string ReferenceCode { get; set; } = "";
    private bool IsPaying { get; set; }
    private string? PaymentError { get; set; }

    private bool ShowCancelModal { get; set; }
    private string CancelReason { get; set; } = "";

    private async Task OnLookupKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LookupAsync();
    }

    private async Task LookupAsync()
    {
        if (LookupId <= 0)
        {
            LookupError = "Vui lòng nhập ID hóa đơn hợp lệ.";
            return;
        }

        IsLoading = true;
        LookupError = null;
        PaymentError = null;
        try
        {
            var invoice = await Api.GetAsync<InvoiceDto>($"api/invoices/{LookupId}");
            Invoice = invoice;
            CashGiven = invoice.Remaining;
            ReferenceCode = "";
            var existingIndex = RecentInvoices.FindIndex(i => i.Id == invoice.Id);
            if (existingIndex >= 0)
                RecentInvoices.RemoveAt(existingIndex);
            RecentInvoices.Insert(0, invoice);
        }
        catch (ApiException ex)
        {
            LookupError = ex.Message;
            Invoice = null;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectRecent(InvoiceDto invoice)
    {
        Invoice = invoice;
        CashGiven = invoice.Remaining;
        ReferenceCode = "";
        PaymentError = null;
    }

    private async Task ConfirmPaymentAsync()
    {
        if (Invoice is null)
            return;

        IsPaying = true;
        PaymentError = null;
        try
        {
            var request = new PaymentRequest(Invoice.Remaining, SelectedMethod, string.IsNullOrWhiteSpace(ReferenceCode) ? null : ReferenceCode, null);
            var updated = await Api.PostAsync<PaymentRequest, InvoiceDto>($"api/invoices/{Invoice.Id}/payments", request);
            Invoice = updated;
            var index = RecentInvoices.FindIndex(i => i.Id == updated.Id);
            if (index >= 0)
                RecentInvoices[index] = updated;
        }
        catch (ApiException ex)
        {
            PaymentError = ex.Message;
        }
        finally
        {
            IsPaying = false;
        }
    }

    private async Task ConfirmCancelInvoiceAsync()
    {
        if (Invoice is null || string.IsNullOrWhiteSpace(CancelReason))
        {
            PaymentError = "Vui lòng nhập lý do hủy.";
            return;
        }

        try
        {
            var updated = await Api.PatchAsync<CancelInvoiceRequest, InvoiceDto>($"api/invoices/{Invoice.Id}/cancel", new CancelInvoiceRequest(CancelReason));
            Invoice = updated;
            var index = RecentInvoices.FindIndex(i => i.Id == updated.Id);
            if (index >= 0)
                RecentInvoices[index] = updated;
            ShowCancelModal = false;
            CancelReason = "";
        }
        catch (ApiException ex)
        {
            PaymentError = ex.Message;
        }
    }

    private static string FormatCurrency(decimal amount) =>
        amount.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + "đ";

    private static string InvoiceStatusLabel(InvoiceDto invoice) => invoice.IsCancelled
        ? "Đã hủy"
        : invoice.Status switch
        {
            InvoiceStatus.Unpaid => "Chờ thu tiền",
            InvoiceStatus.PartiallyPaid => "Thu một phần",
            InvoiceStatus.Paid => "Đã thu",
            _ => invoice.Status.ToString(),
        };

    private static string InvoiceStatusClass(InvoiceDto invoice) => invoice.IsCancelled
        ? "bg-error-container text-on-error-container"
        : invoice.Status switch
        {
            InvoiceStatus.Unpaid => "bg-amber-100 text-amber-800",
            InvoiceStatus.PartiallyPaid => "bg-amber-100 text-amber-800",
            InvoiceStatus.Paid => "bg-emerald-100 text-emerald-800",
            _ => "bg-surface-container-high text-on-surface-variant",
        };
}
