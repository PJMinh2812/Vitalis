<aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 flex flex-col justify-between select-none"><div class="flex flex-col flex-1"><div class="h-16 px-space-md flex items-center gap-space-sm bg-surface-container-lowest"><img alt="Vitalis" class="h-8 w-auto object-contain" src="images/logo.png"/><div class="flex flex-col min-w-0"><span class="font-title-md text-title-md text-primary tracking-tight truncate">Vitalis OS</span><span class="font-label-xs text-label-xs text-on-surface-variant truncate">Phân Hệ Dược &amp; Nhà Thuốc</span></div></div><div class="px-space-md py-space-sm"><div class="px-space-sm py-space-xs"><span class="font-label-xs text-label-xs font-bold uppercase tracking-wider text-on-surface-variant">PHÂN HỆ DƯỢC</span></div></div><nav class="flex-1 px-space-sm space-y-1" data-active-classes="bg-primary-container text-on-primary font-bold"><a href="/pharmacy/dispense" data-path="cap-phat-thuoc" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors"><span class="material-symbols-outlined text-[20px]">medication</span><span class="truncate">Cấp phát thuốc</span></a><a href="/pharmacy/inventory" data-path="quan-ly-kho-duoc" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors"><span class="material-symbols-outlined text-[20px]">inventory_2</span><span class="truncate">Quản lý kho dược</span></a><a href="/pharmacy/receipt" data-path="nhap-kho-va-ncc" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors"><span class="material-symbols-outlined text-[20px]">local_shipping</span><span class="truncate">Nhập kho &amp; NCC</span></a></nav></div><div class="p-space-sm bg-surface-container-lowest"><div class="bg-surface-container-low p-space-sm rounded-lg mb-space-xs"><div class="flex items-center justify-between mb-1"><span class="font-label-xs text-label-xs font-semibold text-primary">Quầy phát 01</span><span class="inline-flex items-center px-1.5 py-0.5 rounded-full font-label-xs text-[10px] bg-primary-fixed text-on-primary-fixed">Đang tiếp nhận đơn</span></div><div class="flex items-center gap-1 font-label-xs text-label-xs text-on-surface-variant"><span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"></span><span>Ca sáng: 07:00 - 15:30</span></div></div><a href="/login" data-path="dang-xuat" class="flex items-center justify-center gap-space-xs w-full py-2 px-space-md rounded-lg font-label-md text-label-md text-error hover:bg-error-container hover:text-on-error-container transition-colors" @onclick="HandleLogoutAsync" @onclick:preventDefault="true"><span class="material-symbols-outlined text-[18px]">logout</span><span>Đăng xuất</span></a></div></aside><div class="pl-64"><header class="fixed top-0 left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 px-space-md flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-sm min-w-0"><div class="hidden xl:flex items-center gap-1 font-body-sm text-body-sm text-on-surface-variant truncate"><span>Phòng khám Vitalis</span><span class="material-symbols-outlined text-[14px]">chevron_right</span><span>Kho Dược &amp; Nhà thuốc</span><span class="material-symbols-outlined text-[14px]">chevron_right</span><span class="font-label-sm text-label-sm text-primary font-medium truncate">Hệ thống Quản lý Dược</span></div></div><div class="flex-1 max-w-xl mx-space-sm"><div class="relative flex items-center w-full"><span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-[18px]">search</span><input class="w-full h-9 pl-9 pr-14 bg-surface-container-low rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant outline-none focus:bg-surface-container-lowest transition-colors" placeholder="Tìm tên biệt dược, hoạt chất, số lô, mã đơn thuốc..." type="text"/><kbd class="absolute right-2 px-1.5 py-0.5 rounded font-label-xs text-label-xs text-on-surface-variant bg-surface-container">Ctrl+K</kbd></div></div><div class="flex items-center gap-space-sm shrink-0"><div class="hidden md:flex items-center gap-2 px-space-sm py-1 rounded-full bg-surface-container-low"><span class="w-2 h-2 rounded-full bg-primary"></span><span class="font-label-xs text-label-xs text-on-surface truncate">Kho Chẵn &amp; Nhà thuốc Ngoại trú - Tầng 1</span><span class="font-label-xs text-[10px] text-primary font-semibold">(Mở cửa)</span></div><button class="relative p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" type="button"><span class="material-symbols-outlined text-[20px]">notifications</span><span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-error ring-2 ring-surface-container-lowest"></span></button><div class="flex items-center gap-space-xs pl-space-xs cursor-pointer"><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div><div class="hidden lg:flex flex-col text-left"><span class="font-label-sm text-label-sm text-on-surface font-semibold truncate leading-tight">@(TokenStore.CurrentUser?.FullName)</span><span class="font-label-xs text-label-xs text-on-surface-variant truncate leading-tight">Dược sĩ phụ trách chuyên môn</span></div><span class="material-symbols-outlined text-on-surface-variant text-[16px]">expand_more</span></div></div></header>
<main class="relative pt-16 bg-surface min-h-screen">
@Body
</main>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        if (TokenStore.RefreshToken is { } refreshToken)
        {
            try { await Api.LogoutAsync(refreshToken); }
            catch (ApiException) { }
        }
        TokenStore.Clear();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
