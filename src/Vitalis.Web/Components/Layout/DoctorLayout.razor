rounded-lg" data-nav-off="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md"><span class="material-symbols-outlined text-[20px]">stethoscope</span><span>Khám bệnh &amp; Kê đơn</span></a></nav></div><div class="p-space-md bg-surface-container-low flex flex-col gap-space-sm"><div class="flex items-center justify-between bg-surface-container-lowest px-space-sm py-1.5 rounded-lg"><div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span><span class="font-label-xs text-label-xs text-on-surface font-semibold">Đang trong ca trực</span></div><span class="font-label-xs text-label-xs text-primary font-medium bg-primary-fixed/30 px-1.5 py-0.5 rounded">P.203 - Tầng 2</span></div><button class="flex items-center justify-center gap-space-xs w-full py-2 px-space-sm rounded-lg text-error hover:bg-error-container hover:text-on-error-container transition-colors font-label-sm text-label-sm" type="button" @onclick="HandleLogoutAsync"><span class="material-symbols-outlined text-[18px]">logout</span><span>Đăng xuất</span></button></div></aside><div class="pl-64"><header class="fixed top-0 left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 px-gutter flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-sm min-w-0"><div class="flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm whitespace-nowrap overflow-hidden text-ellipsis"><span class="text-outline hover:text-on-surface cursor-pointer">Phòng khám Vitalis</span><span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span><span class="text-outline hover:text-on-surface cursor-pointer">Phân hệ Bác sĩ Lâm sàng</span><span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span><span class="font-semibold text-primary">Hàng chờ khám</span></div><div class="hidden xl:flex items-center gap-1.5 bg-primary-container/10 px-2.5 py-1 rounded-full text-primary font-label-xs text-label-xs font-semibold ml-space-sm"><span class="material-symbols-outlined text-[14px]">meeting_room</span><span>Phòng 203 - Khám Nội tổng quát &amp; Tim mạch</span></div></div><div class="flex items-center gap-space-md shrink-0"><div class="relative hidden md:block w-64"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-outline">search</span><input class="w-full h-9 pl-9 pr-3 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-sm text-body-sm focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary" placeholder="Tìm bệnh nhân, mã EMR..." type="text"/></div><button class="relative p-2 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" type="button"><span class="material-symbols-outlined text-[20px]">notifications</span><span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-error ring-2 ring-surface-container-lowest"></span></button><div class="flex items-center gap-space-sm pl-space-xs"><div class="flex flex-col text-right hidden sm:flex"><span class="font-label-md text-label-md font-semibold text-on-surface leading-tight">@(TokenStore.CurrentUser?.FullName)</span><span class="font-label-xs text-label-xs text-on-surface-variant leading-tight">Khoa Nội tổng quát • 07:30 - 16:30</span></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header>
<main class="w-full pt-16 bg-surface min-h-screen px-margin py-gutter">
@Body
</main>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        if (TokenStore.RefreshToken is { } refreshToken)
        {
            try { await Api.LogoutAsync(refreshToken); }
            catch (ApiException) { }
        }
        TokenStore.Clear();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
